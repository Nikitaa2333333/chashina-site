---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArrowChip from '../components/ArrowChip.astro';
import { asset } from '../lib/asset';
import press from '../data/press.json';

// Данные собирает scripts/press-build.mjs из прогона по ссылкам.
// Руками не править: следующий прогон перезапишет.
type Item = {
  title: string;
  outlet: string;
  kind: string;
  year: number | null;
  url: string;
  cover: string | null;
  quote: string | null;
  tier: 'full' | 'card' | 'line';
};

const items = press as Item[];

// Фильтры по типу и изданию тут были — сняты: список читают подряд,
// как ленту, а порядок задаёт свежесть (его держит scripts/press-build.mjs).
const years = items.map((r) => r.year).filter((y): y is number => Boolean(y));
const outlets = new Set(items.map((r) => r.outlet)).size;

const label = (r: Item) => [r.outlet, r.year].filter(Boolean).join(' · ');
---

<Base
  title="Публикации в СМИ — Оксана Чащина"
  description={`${items.length} материалов в ${outlets} изданиях: РБК, ТАСС, Buro 24/7, АиФ и другие. Комментарии и интервью врача-косметолога Оксаны Чащиной.`}
>
  <Header />

  <main class="section press-page">
    <div class="container">
      <a class="crumb mono" href="/">← На главную</a>
      <span class="tag mono">Публикации</span>
      <h1 class="press-page__title">Мои статьи в СМИ.</h1>
      <p class="press-page__intro">
        Издания обращаются ко мне за комментарием — и через их вопросы
        я объясняю то, что важно знать о коже и уходе: чем точнее пациент
        понимает, как всё устроено, тем осмысленнее его решения.
        {items.length} материалов в {outlets} изданиях с {Math.min(...years)} по {Math.max(...years)} год,
        свежие сверху. Каждая карточка ведёт к оригиналу на сайте издания.
      </p>

      <div class="parchive">
        {items.map((r) => (
          <a class={`pcard pcard--${r.tier}`} href={r.url} target="_blank" rel="noopener noreferrer">
            {r.cover && (
              <img class="pcard__cover" src={asset(r.cover)} alt="" loading="lazy" width="640" height="427" />
            )}
            <span class="pcard__meta mono">{label(r)}</span>
            <span class="pcard__title">{r.title}</span>
            {r.quote && <span class="pcard__quote">{r.quote}</span>}
            <ArrowChip class="pcard__chip" />
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .press-page {
    padding-top: 108px; /* шапка fixed */
  }
  .press-page__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 12px;
  }
  .press-page__intro {
    font-size: var(--text-lead);
    max-width: var(--measure-lead);
    margin-top: 20px;
  }

  /* ---------- Сетка ----------
     Колонки, а не grid: карточки разной высоты (обложка, обложка с цитатой,
     голая строка) в grid оставляют дыры. break-inside держит карточку целой. */
  .parchive {
    columns: 3;
    column-gap: 20px;
    margin-top: var(--block-gap);
  }
  /* Все карточки одинаковые — тёмные плашки, и с иллюстрацией, и без.
     Белые вперемешку с тёмными читались как две разные сущности. */
  .pcard {
    display: block;
    break-inside: avoid;
    margin-bottom: 20px;
    padding: 20px 20px 24px;
    border-radius: var(--radius-card);
    background: var(--ink);
    color: var(--bone);
    border: 1px solid var(--ink);
    position: relative;
    transition: transform 0.35s var(--ease), border-color 0.25s var(--ease);
  }
  .pcard:hover {
    transform: translateY(-3px);
    border-color: var(--lime);
  }

  /* Обложка в край карточки: вылезает из падингов отрицательными полями,
     скругление повторяет верхние углы карточки. */
  .pcard__cover {
    width: calc(100% + 40px);
    /* глобальное img { max-width: 100% } иначе срезает эти +40px обратно
       до ширины контента, и обложка не дотягивается до края плашки */
    max-width: none;
    margin: -20px -20px 16px;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }
  .pcard__meta {
    display: block;
    margin-bottom: 8px;
    color: var(--lime);
  }
  .pcard__title {
    display: block;
    font-size: var(--text-card-title);
    letter-spacing: var(--track-heading);
    line-height: 1.2;
  }
  .pcard__quote {
    display: block;
    margin-top: 12px;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  /* :global — чип приходит из компонента ArrowChip, и scoped-стиль
     страницы до его корневого элемента не достаёт. */
  .pcard :global(.arrow-chip) {
    position: absolute;
    right: 16px;
    bottom: 16px;
    transform: scale(0.62);
    transform-origin: bottom right;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .pcard:hover :global(.arrow-chip) { opacity: 1; }

  /* Без картинки плашке нужно чуть больше воздуха: её высоту держит
     только текст, иначе в ленте она выглядит обрезанной. */
  .pcard--line {
    padding-block: 26px 30px;
  }

  @media (max-width: 1000px) {
    .parchive { columns: 2; }
  }
  /* Один брейкпоинт с сеткой прессы на главной и со списком блога:
     на телефоне все три раскладки становятся одной колонкой */
  @media (max-width: 640px) {
    .parchive { columns: 1; }
    .pcard { padding: 18px 18px 22px; }
    .pcard__cover { width: calc(100% + 36px); margin: -18px -18px 14px; }
  }
</style>
