---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArrowChip from '../components/ArrowChip.astro';
import { asset } from '../lib/asset';
import press from '../data/press.json';

// Данные собирает scripts/press-build.mjs из прогона по ссылкам.
// Руками не править: следующий прогон перезапишет.
type Item = {
  title: string;
  outlet: string;
  kind: string;
  year: number | null;
  url: string;
  cover: string | null;
  quote: string | null;
  tier: 'full' | 'card' | 'line';
};

const items = press as Item[];

// Фильтры по типу и изданию тут были — сняты: список читают подряд,
// как ленту, а порядок задаёт свежесть (его держит scripts/press-build.mjs).
const years = items.map((r) => r.year).filter((y): y is number => Boolean(y));
const outlets = new Set(items.map((r) => r.outlet)).size;

const label = (r: Item) => [r.outlet, r.year].filter(Boolean).join(' · ');
---

<Base
  title="Публикации в СМИ — Оксана Чащина"
  description={`${items.length} материалов в ${outlets} изданиях: РБК, ТАСС, Buro 24/7, АиФ и другие. Комментарии и интервью врача-косметолога Оксаны Чащиной.`}
>
  <Header />

  <main class="section press-page">
    <div class="container">
      <a class="crumb mono" href="/">← На главную</a>
      <span class="tag mono">Публикации</span>
      <h1 class="press-page__title">Мои статьи в СМИ.</h1>
      <p class="press-page__intro">
        Издания обращаются ко мне за комментарием, я рассказываю, что важно
        знать о коже и уходе: чем точнее пациент понимает, как всё устроено,
        тем осмысленнее его решения.
        {items.length} материалов в {outlets} изданиях с {Math.min(...years)} по {Math.max(...years)} год,
        свежие сверху. Каждая карточка ведёт к оригиналу на сайте издания.
      </p>

      <div class="parchive">
        {items.map((r) => (
          <a class={`pcard pcard--${r.tier}`} href={r.url} target="_blank" rel="noopener noreferrer">
            {r.cover && (
              <img class="pcard__cover" src={asset(r.cover)} alt="" loading="lazy" width="640" height="427" />
            )}
            <span class="pcard__meta mono">{label(r)}</span>
            <span class="pcard__title">{r.title}</span>
            {r.quote && <span class="pcard__quote">{r.quote}</span>}
            <ArrowChip class="pcard__chip" />
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .press-page {
    padding-top: 108px; /* шапка fixed */
  }
  .press-page__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 12px;
  }
  .press-page__intro {
    font-size: var(--text-lead);
    max-width: var(--measure-lead);
    margin-top: 20px;
  }

  /* ---------- Сетка ----------
     Колонки, а не grid: карточки разной высоты (обложка, обложка с цитатой,
     голая строка) в grid оставляют дыры. break-inside держит карточку целой. */
  .parchive {
    columns: 3;
    column-gap: 20px;
    margin-top: var(--block-gap);
  }
  /* Оформление карточки — .pcard в global.css, общее с лентой прессы
     на главной. Здесь только размещение в колонках: break-inside держит
     карточку целой, отступ снизу разводит соседей по колонке. */
  .parchive :global(.pcard) {
    break-inside: avoid;
    margin-bottom: 20px;
  }

  @media (max-width: 1000px) {
    .parchive { columns: 2; }
  }
  /* Один брейкпоинт с лентой прессы на главной и со списком блога:
     на телефоне все три раскладки становятся одной колонкой */
  @media (max-width: 640px) {
    .parchive { columns: 1; }
  }
</style>
