---
// ВРЕМЕННАЯ страница сравнения версий блока «Образование и практика».
// Нужна ровно затем, чтобы заказчик посмотрел аккордеон живьём, а не на
// скриншоте, и сравнил с рельсами, которые сейчас стоят на главной.
// noindex + исключение из карты сайта (фильтр в astro.config.mjs):
// служебной странице нечего делать в поиске.
//
// УДАЛИТЬ вместе с проигравшим вариантом, как только выбор сделан.
// Данные обе версии берут из src/data/cv.ts — расходиться им нечем.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import CvAccordion from '../components/CvAccordion.astro';
import { cvEdu, cvExtra, cvWork, cvYears } from '../data/cv';

const groups = [
  { key: 'edu', title: 'Образование', theme: 'paper' as const, list: cvEdu },
  { key: 'extra', title: 'Дополнительное профильное образование', theme: 'tissue' as const, list: cvExtra },
  { key: 'work', title: 'Практика', theme: 'ink' as const, list: cvWork },
];

// Рельсы повторены здесь один в один с главной, чтобы сравнение было честным:
// одна страница, один кегль, один экран — переключаться между вкладками и
// держать в голове первый вариант не нужно.
const rails = [
  { title: 'Образование', list: cvEdu },
  { title: 'Дополнительное профильное образование', list: cvExtra },
  { title: 'Практика', list: cvWork },
];
---

<Base title="Образование — две версии блока" noindex>
  <main class="section cvdemo">
    <div class="container">
      <a class="crumb mono" href="/">← На главную</a>
      <h1 class="cvdemo__title">Образование и практика: две версии.</h1>
      <p class="cvdemo__intro">
        Служебная страница для выбора. Наверху — раскрывающиеся плашки,
        ниже — горизонтальные рельсы, которые стоят на главной сейчас.
        Состав записей у обеих версий одинаковый, отличается только подача.
      </p>
    </div>

    <div class="container cvdemo__block">
      <span class="tag mono">Версия A — плашки</span>
      <CvAccordion groups={groups} />
      <p class="cvdemo__note">
        Плашки открываются независимо друг от друга: можно держать раскрытыми
        все три или ни одной. По умолчанию открыто «Образование», остальное
        свёрнуто — весь раздел занимает один экран вместо трёх.
      </p>
    </div>

    <div class="cvdemo__block">
      <span class="container tag mono">Версия B — рельсы (сейчас на сайте)</span>
      <div class="cv__rails">
        {rails.map((g) => (
          <div class="cv__rail-group">
            <span class="container cv__rail-title mono">{g.title}</span>
            <div class="cv__rail" tabindex="0" role="group" aria-label={g.title}>
              <div class="cv__track">
                {g.list.map((o) => (
                  <div class="cv__stop">
                    <span class="cv__dot" aria-hidden="true"></span>
                    <span class="cv__years mono">{cvYears(o)}</span>
                    <span class="cv__place">{o.place}</span>
                    {o.note && <span class="cv__note">{o.note}</span>}
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="container cvdemo__note">
        Рельсы тянутся вбок мышью, колесом и свайпом. Раздел всегда развёрнут
        целиком — видно сразу всё, но три ленты подряд занимают заметно
        больше высоты.
      </p>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .cvdemo {
    padding-top: 72px;
  }
  .cvdemo__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 12px;
  }
  .cvdemo__intro {
    font-size: var(--text-lead);
    max-width: var(--measure-lead);
    margin-top: 20px;
  }
  .cvdemo__block {
    margin-top: clamp(44px, 5.5vw, 84px);
  }
  .cvdemo__block .tag {
    margin-bottom: 18px;
    display: inline-flex;
  }
  .cvdemo__note {
    margin-top: 20px;
    max-width: var(--measure-text);
    font-size: 1rem;
  }

  /* ---------- Рельсы: копия правил с главной ----------
     Дублирование осознанное и временное. Выносить их в global.css ради
     служебной страницы, которая скоро удалится, — значит тащить в общий
     файл то, что через неделю станет мусором. */
  .cv__rails {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 44px);
  }
  .cv__rail-title {
    display: block;
    margin-bottom: 14px;
  }
  .cv__rail {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-left: max(var(--gutter), calc((100% - var(--page-max)) / 2 + var(--gutter)));
    padding-right: var(--gutter);
  }
  .cv__rail::-webkit-scrollbar { display: none; }
  .cv__rail:focus-visible {
    outline: 2px solid var(--lime-2);
    outline-offset: 4px;
  }
  .cv__track {
    position: relative;
    display: flex;
    width: max-content;
    padding-top: 22px;
  }
  .cv__track::before {
    content: '';
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--sage);
  }
  .cv__stop {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: clamp(168px, 15vw, 216px);
    padding-right: 20px;
  }
  .cv__dot {
    position: absolute;
    top: -22px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--lime-2);
    transition: transform 0.25s var(--ease), background 0.25s var(--ease);
  }
  .cv__stop:hover .cv__dot,
  .cv__stop:focus-within .cv__dot {
    transform: scale(1.4);
    background: var(--lime);
  }
  .cv__years { color: var(--ink); }
  .cv__place { font-size: 0.95rem; line-height: 1.25; }
  .cv__note  { font-size: 0.85rem; line-height: 1.25; }
</style>
