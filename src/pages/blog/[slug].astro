---
// ================= СТРАНИЦА ПОСТА =================
// Полный текст поста из телеграм-канала + карусель фото (альбомы телеграма).
// Карусель — горизонтальный scroll-snap с чипами-стрелками; на тач-экранах
// и с reduced-motion работает нативный свайп, стрелки просто скроллят.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BtnPair from '../../components/BtnPair.astro';
import data from '../../data/telegram-posts.json';

export function getStaticPaths() {
  return data.posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;

const fmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const human = fmt.format(new Date(post.date)).replace(/\s*г\.$/, '');
const many = post.photos.length > 1;
---

<Base title={`${post.title} — блог Оксаны Чащиной`} description={post.excerpt}>
  <Header />

  <main class="section post">
    <article class="container post__col">
      <nav class="post__crumbs mono" aria-label="Хлебные крошки">
        <a class="post__back" href="/">← На главную</a>
        <span class="post__date">{human}</span>
      </nav>
      <h1 class="post__title">{post.title}</h1>

      {post.photos.length > 0 && (
        <div class={`carousel ${many ? 'carousel--many' : ''}`} data-carousel>
          <div class="carousel__track" data-track>
            {post.photos.map((ph) => (
              <figure class="carousel__slide">
                <img src={ph.src} alt="" width={ph.w} height={ph.h} loading="lazy" />
              </figure>
            ))}
          </div>
          {many && (
            <div class="carousel__ui">
              <button class="carousel__btn" data-prev aria-label="Предыдущее фото">
                <svg width="15" height="15" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M6.8 1.6 3.2 5l3.6 3.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <span class="carousel__count mono" data-count>1 / {post.photos.length}</span>
              <button class="carousel__btn" data-next aria-label="Следующее фото">
                <svg width="15" height="15" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path d="M3.2 1.6 6.8 5 3.2 8.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          )}
        </div>
      )}

      <div class="post__body" set:html={post.html} />

      <div class="post__foot">
        <a class="post__tg mono" href={post.tgUrl} target="_blank" rel="noopener">
          Читать в Telegram
        </a>
        <BtnPair label="Записаться на консультацию" href="/#contact" />
      </div>

      <!-- Возврат к списку — внизу: наверху страницы это «на главную»,
           к остальным постам читатель уходит, дочитав этот -->
      <a class="post__all mono" href="/blog/">← Все статьи блога</a>
    </article>
  </main>

  <Footer />
</Base>

<style>
  .post {
    padding-top: clamp(110px, 14vh, 150px);
  }
  /* Узкая читальная колонка по центру */
  .post__col {
    max-width: calc(760px + var(--gutter) * 2);
  }
  .post__crumbs {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .post__back {
    padding: 10px 14px;
    margin-left: -14px;
    background: var(--paper);
    border-radius: var(--radius-btn);
    transition: background 0.25s var(--ease);
  }
  .post__back:hover {
    background: var(--lime);
  }
  .post__title {
    font-size: var(--text-heading);
    letter-spacing: var(--track-heading);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 22px;
  }

  /* ---------- Карусель ---------- */
  .carousel {
    margin-top: var(--block-gap);
  }
  .carousel__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    border-radius: var(--radius-card);
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .carousel__slide {
    flex: none;
    scroll-snap-align: start;
  }
  /* Высота одна на все кадры — вертикальные и горизонтальные встают в ряд */
  .carousel__slide img {
    height: min(62vh, 560px);
    width: auto;
    max-width: 88vw;
    object-fit: cover;
    border-radius: var(--radius-card);
  }
  /* Одиночное фото — просто врезка на всю колонку */
  .carousel:not(.carousel--many) .carousel__slide {
    width: 100%;
  }
  .carousel:not(.carousel--many) .carousel__slide img {
    width: 100%;
    height: auto;
    max-height: 68vh;
  }
  .carousel__ui {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 14px;
  }
  .carousel__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 40px;
    border: 0;
    cursor: pointer;
    background: var(--lime);
    color: var(--ink);
    border-radius: var(--radius-btn);
    transition: background 0.25s var(--ease);
  }
  .carousel__btn:hover {
    background: var(--lime-2);
  }
  .carousel__count {
    min-width: 5ch;
    text-align: center;
  }

  /* ---------- Текст поста ---------- */
  .post__body {
    margin-top: var(--block-gap);
    max-width: var(--measure-text);
  }
  .post__body :global(p) {
    line-height: 1.45;
  }
  .post__body :global(p + p) {
    margin-top: 1em;
  }
  .post__body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: background 0.25s var(--ease);
  }
  .post__body :global(a:hover) {
    background: var(--lime);
    text-decoration: none;
  }

  .post__foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: clamp(28px, 4vw, 44px);
  }
  .post__tg {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: var(--paper);
    border-radius: var(--radius-btn);
    transition: background 0.25s var(--ease);
  }
  .post__tg::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--lime-2);
  }
  .post__tg:hover {
    background: var(--lime);
  }
  .post__all {
    display: inline-block;
    margin-top: clamp(30px, 5vw, 56px);
    padding: 12px 16px;
    margin-left: -16px;
    border-radius: var(--radius-btn);
    transition: background 0.25s var(--ease);
  }
  .post__all:hover {
    background: var(--lime);
  }
</style>

<script>
  // Стрелки карусели: скроллим трек на ширину текущего слайда, счётчик —
  // от фактического scrollLeft (свайп пальцем тоже двигает счётчик).
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    if (!track) return;
    const slides = Array.from(track.children) as HTMLElement[];
    if (slides.length < 2) return;

    const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const current = () => {
      let best = 0;
      let dist = Infinity;
      slides.forEach((s, i) => {
        const d = Math.abs(s.offsetLeft - track.scrollLeft);
        if (d < dist) {
          dist = d;
          best = i;
        }
      });
      return best;
    };
    const go = (dir: number) => {
      const next = Math.min(slides.length - 1, Math.max(0, current() + dir));
      track.scrollTo({ left: slides[next].offsetLeft, behavior: smooth ? 'smooth' : 'auto' });
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(1));
    track.addEventListener(
      'scroll',
      () => {
        if (count) count.textContent = `${current() + 1} / ${slides.length}`;
      },
      { passive: true }
    );
  });
</script>
