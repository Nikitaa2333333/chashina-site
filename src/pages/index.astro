---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import BtnPair from '../components/BtnPair.astro';
import ArrowChip from '../components/ArrowChip.astro';
import Footer from '../components/Footer.astro';
import pressAll from '../data/press.json';
import { asset } from '../lib/asset';

// 4. Как строится работа — три ступени.
// Текст ступени — массив абзацев: Оксана расписала каждый этап на два-три
// (правка в Google-документе от 01.09.2026), одной строкой это уже не читается.
const steps = [
  {
    n: '01.',
    title: 'Диагностика',
    text: [
      'На первом этапе я оцениваю тип старения, состояние кожи, её плотность и эластичность, выраженность отёков, сосудистые изменения и другие факторы.',
      'При необходимости рекомендую лабораторную диагностику. Потому что не каждое изменение кожи необходимо корректировать косметологическими процедурами — иногда причина находится за пределами косметологии.',
    ],
    theme: 'lime',
  },
  {
    n: '02.',
    title: 'Подготовка тканей',
    text: [
      'Если кожа и ткани находятся в состоянии выраженной сухости, отёчности, сниженной микроциркуляции или имеют другие функциональные нарушения, сначала работаем с этими состояниями.',
      'На этом этапе могут использоваться уходовые процедуры, микротоки, радиоволновые методики и другие методы — выбор всегда зависит от состояния тканей.',
    ],
    theme: 'ink',
  },
  {
    n: '03.',
    title: 'Стимуляция и лифтинг',
    text: [
      'И только после подготовки тканей можно переходить к более интенсивным методам, направленным на стимуляцию неоколлагенеза, ремоделирование дермы и повышение плотности тканей.',
      'Лифтинг не должен быть самоцелью. Если качество тканей снижено, попытка сразу воздействовать интенсивными методами не всегда даёт ожидаемый результат.',
      'В косметологии я придерживаюсь принципа «сначала восстановить условия для нормальной работы тканей — затем стимулировать».',
    ],
    theme: 'frost',
  },
];

// 11. Видео — вертикальные ролики из инстаграма Оксаны.
// Порядок пока произвольный (файлы пришли без тем), подписей нет —
// карточка это сам ролик.
const reels = ['01', '02', '03', '04'].map((n) => ({
  src: `/video/reels/reel-${n}.mp4`,
  poster: `/video/reels/reel-${n}.webp`,
}));

// Принципы. Секцию убирали 07.08 (были три фразы копирайтера), но Оксана
// переписала блок в Google-документе — по два абзаца на принцип, — поэтому
// вернули с её текстом. Абзацы массивом, как у ступеней.
const principles = [
  {
    title: 'Безопасность технологии',
    text: [
      'И для пациента и для врача — это база. Важно понимать, что выбирая врача и его опыт, воздействия не могут быть за рамками физиологичности. Лечение должно быть эффективным и безопасным.',
      'Мои терапевтические планы базируются на глубоких знаниях анатомии, физиологии, биохимии, превентивной медицины и физиотерапии в рамках эстетической медицины.',
    ],
  },
  {
    title: 'Предсказуемость результата',
    text: [
      'Вся разработанная мною терапия всегда длительная и аккуратно дозированная, она распределена по году индивидуально и строится на необходимости и видимых структурных изменениях мягких тканей. Сезонность для моих лечебных планов никогда не является препятствием для омоложения кожи и организма в целом.',
      'Всегда моя терапия эффективна и безопасна. Мои пациенты со мной годы и десятилетия. Они всегда выглядят очень естественно и молодо. Их кожа здоровая и красивая.',
    ],
  },
  {
    title: 'Ваше участие',
    text: [
      'Косметология не работает в отрыве от чекапов, сна, физической нагрузки и управления стрессом.',
      'Вся превентивная косметология базируется на принципе вовлечённости, участия пациента в процесс лечения, омоложения.',
    ],
  },
];

// 5. Аппаратные методы — четыре направления
// theme задаёт цвет текста и скрим под ним: dark-фото → светлый текст
const methods = [
  {
    n: '01.',
    title: 'Световые и лазерные методики',
    text: 'Пигмент, сосуды, поры, морщины, качество поверхности кожи — всё это является точкой приложения световых методов, и работают они со «старыми» клетками, корректируя не только поверхностные изменения, но и метаболизм тканей. Удаляясь, «дефектные» клетки дают стимул для выработки новых качественных молодых белковых структур.',
    // Название механизма, которое Оксана дописала к абзацу в документе:
    // идёт служебной меткой под текстом, а не частью наборного текста
    note: 'Клеточная сенесценция',
    img: '/photos/art/method-01.webp',
    theme: 'dark',
  },
  {
    n: '02.',
    title: 'Радиоволновой лифтинг',
    text: 'Контролируемый прогрев тканей запускает выработку коллагена — кожа постепенно возвращает плотность и тонус.',
    img: '/photos/art/method-02.webp',
    theme: 'light',
  },
  {
    n: '03.',
    title: 'Токи и микротоки',
    text: 'Дренаж, тонус, работа с отёчностью. Мягкие методики, которые готовят ткани к более мощным воздействиям.',
    img: '/photos/art/method-03.webp',
    theme: 'dark',
  },
  {
    n: '04.',
    title: 'Фокусированный ультразвук',
    text: 'Работа с глубоким каркасом лица — тем слоем, до которого не достают кремы и поверхностные процедуры.',
    img: '/photos/art/method-04.webp',
    theme: 'dark',
  },
];

// 7. Инъекционные методы — задачи
const tasks = [
  {
    n: '01.',
    title: 'Качество и увлажнённость кожи',
    text: 'Плотность, сияние, увлажнённость — работа с самой тканью кожи, а не с её объёмами.',
  },
  {
    n: '02.',
    title: 'Объёмы и опора тканей',
    text: 'Восстановление опоры там, где ткани её потеряли — без попытки «слепить» новое лицо.',
  },
  {
    n: '03.',
    title: 'Мимические зоны',
    text: 'Расслабить то, что заламывает кожу, сохранив живую мимику и естественное выражение.',
  },
  {
    n: '04.',
    title: 'Асимметрия',
    text: 'Аккуратное выравнивание врождённых и возрастных асимметрий — работа ювелирная и очень индивидуальная.',
  },
];

// 13. Публикации в СМИ — данные собирает scripts/press-build.mjs.
// Первыми идут шесть карточек из текстов копирайтера (блок 13): имена,
// которые названы в лиде выше. Сортировка «свежие с цитатой» тут не годится —
// она выдавала четыре Beauty Insider подряд, а РБК с ТАСС не показывала.
// Материал ищем по url в press.json, чтобы заголовок и год были из прогона.
// Дальше лента добирается свежими: карточек в ней 12, а не 6 — в горизонтальной
// ленте на экран попадает 3–4, и с шестью тянуть было бы почти нечего.
const PRESS_PICKS = [
  'rbc.ru/life/news/6a1ee0c7',
  'tass.ru/obschestvo/27249099',
  'gazeta.ru/style/news/2023/04/11',
  'flacon-magazine.com/ukhod/kosmetologiya/3580194',
  // У материала про устаревшие процедуры нет своей иллюстрации, а карточка
  // без обложки в сцене выглядит дырой — берём у того же издания текст
  // с обложкой (про тёмные круги).
  'umagazine.ru/krasota/health/effekt-pandy',
  'beautyhack.ru/krasota/uhod/wellness',
];
// Ссылка могла отвалиться на прогоне — тогда карточку добираем свежей.
// В ленту идут ТОЛЬКО материалы с обложкой: их 35 из 69, на 12 карточек
// хватает с запасом, а текстовая плашка среди фото-плашек читается пропуском.
const pressPicked = PRESS_PICKS.map((u) => pressAll.find((p) => p.url.includes(u))).filter(
  (p) => p && p.cover
);
const pressFeatured = [
  ...pressPicked,
  ...pressAll
    .filter((p) => p.cover && !pressPicked.includes(p))
    .sort((a, b) => (b.year ?? 0) - (a.year ?? 0)),
].slice(0, 12);
const pressOutlets = new Set(pressAll.map((p) => p.outlet)).size;

// 16. Отзывы — независимые агрегаторы. Тексты отзывов с площадок НЕ копируем:
// текст принадлежит автору-пациенту и площадке (их правила запрещают
// перепечатку), а благодарности пациентов на сайте врача рискуют попасть под
// запреты рекламы медуслуг (ст. 24 ФЗ «О рекламе»). Поэтому на сайте только
// факты — цифры и ссылки на первоисточник.
// Цифры проверены 2026-08-26; при заходе в этот код сверять с площадками —
// устаревший рейтинг превращается в недостоверную рекламу.
const reviewCards = [
  {
    source: 'ПроДокторов',
    stat: '20',
    label: 'отзывов пациентов',
    url: 'https://prodoctorov.ru/moskva/vrach/218823-chashina/',
  },
  {
    source: 'Яндекс Здоровье',
    stat: '95%',
    label: 'пациентов рекомендуют — 21 отзыв',
    url: 'https://yandex.ru/medicine/doctor/chashchina_oksana_cHJbTtPuEYH78',
  },
];
const reviewMore = [
  {
    name: 'НаПоправку',
    host: 'napopravku.ru',
    url: 'https://napopravku.ru/moskva/doctor-profile/chashhina-oksana-valerevna/',
  },
  {
    name: 'СберЗдоровье',
    host: 'docdoc.ru',
    url: 'https://docdoc.ru/doctor/Chashtina_Oksana',
  },
  {
    name: 'ДОКТУ',
    host: 'doctu.ru',
    url: 'https://doctu.ru/msk/doctor/chashhina-oksana-valerevna',
  },
];

// 14. Обо мне — таймлайн образования и практики.
// Шкала одна на оба ряда: КОЛОНКА СЕТКИ = ОДИН ГОД из [CV_FROM, CV_TO].
// Поэтому учёба и работа стоят на своих годах и видно, что они шли параллельно.
//
// lane — «этаж». Год занимает ~70px, и когда события идут подряд (2010 → 2011,
// 2021 → 2022), подпись в такую колонку не влезает: она шире своей ячейки и
// наезжает на соседа. Соседей разводим по этажам — этаж 1 стоит вплотную к оси,
// этаж 2 отодвинут от неё. Если добавляете запись — проверьте, не встала ли она
// ближе трёх лет к соседу по этажу.
const CV_FROM = 1997;
const CV_TO = 2026;
const CV_COLS = CV_TO - CV_FROM + 1;

const cvEdu = [
  { from: 1997, to: 2002, lane: 1, place: 'Сибирский государственный медицинский университет', note: 'лечебный факультет' },
  { from: 2002, to: 2004, lane: 2, place: 'МГМСУ', note: '«Лечебное дело»' },
  { from: 2004, to: 2006, lane: 1, place: 'РМАПО', note: 'ординатура по дерматовенерологии' },
  { from: 2010, to: 2011, lane: 1, place: 'МГМСУ', note: 'интернатура по хирургии' },
  { from: 2011, to: 2012, lane: 2, place: 'МИУВ МГУПП', note: 'профессиональная переподготовка по косметологии' },
  { from: 2013, to: 2013, lane: 1, place: 'ИППО ФМБЦ им. А. И. Бурназяна', note: 'подготовка по физиотерапии' },
  { from: 2022, to: 2022, lane: 1, place: 'Организация здравоохранения', note: 'переподготовка по общественному здоровью' },
];

const cvWork = [
  { from: 2004, to: 2011, lane: 1, place: 'Врач-косметолог' },
  { from: 2011, to: 2018, lane: 1, place: 'Клиника антиэйджинга', note: 'врач-косметолог, физиотерапевт, заведующая отделением эстетики тела' },
  { from: 2018, to: 2021, lane: 1, place: 'Сеть клиник «Атлас»' },
  { from: 2021, to: 2022, lane: 2, place: '«Олимп Клиник»' },
  { from: 2022, to: CV_TO, lane: 1, place: 'Сеть клиник «Атлас»', now: true },
];

// Подпись годов: точечное событие — один год, текущее место работы — «сейчас».
const cvYears = (o: { from: number; to: number; now?: boolean }) =>
  o.now ? `${o.from} — сейчас` : o.from === o.to ? `${o.from}` : `${o.from}–${o.to}`;

// Номер колонки года (сетка считает колонки с единицы) и длина в колонках.
const cvCol = (year: number) => year - CV_FROM + 1;
const cvSpan = (o: { from: number; to: number }) => Math.max(1, o.to - o.from);

// Точки на оси — годы, с которых начинается запись в любом из рядов.
const cvDots = [...new Set([...cvEdu, ...cvWork].map((o) => o.from))].sort((a, b) => a - b);

// ================= ГАЛЕРЕЯ =================
// Две съёмки идут блоками, а не вперемешку: сначала клиника «Атлас»
// (белый костюм, кабинет, консультация), потом лайфстайл (халаты, тёплый
// интерьер). Смена тона читается как смена главы — если перемешать, получится
// винегрет из белого кабинета и апельсина у глаза.
//
// Ориентация берётся из w/h прямо в разметке: вертикальный кадр занимает
// в мозаике два ряда, горизонтальный — один. Ручных пометок не держим,
// чтобы они не разъезжались с реальными файлами.
//
// lg — кадр для лайтбокса. У лайфстайл-кадров его нет: они и так лежат
// в 1000px, лайтбокс возьмёт тот же файл, что и плитка.
// Пересобрать дериваты: pwsh -File scripts/build-photos.ps1
// ПОРЯДОК КАДРОВ ЗДЕСЬ — ЭТО РАСКЛАДКА, А НЕ ПРОСТО СПИСОК.
//
// В мозаике вертикаль занимает два ряда, горизонталь один, колонок три.
// Раскладку делает dense-упаковка строго по порядку, поэтому список собран
// из блоков, каждый из которых закрывает свои ряды целиком и не оставляет
// уступа следующему:
//
//   F = В Г В В Г Г — три ряда. В каждой колонке оказывается и вертикаль,
//                     и горизонталь: это и даёт рваный ритм.
//   B = В В В       — два ряда, три вертикали в ряд. Хвост, когда горизонтали
//                     кончились.
//
// Сейчас F F F B = 12 вертикалей + 9 горизонталей = 11 ровных рядов.
//
// ДВЕ ЛОВУШКИ, ЕСЛИ МЕНЯЕТЕ СОСТАВ:
//   1. Кратности суммы мало. 12×2+9 = 33 делится на 3, но при другом порядке
//      колонка всё равно уйдёт вниз на целую плитку.
//   2. Блок «В В Г Г» тоже даёт ровный низ, но кладёт все горизонтали
//      в третью колонку — выходят полосы, а не мозаика.
// Проверять замером: scripts/check-gallery.mjs при запущенном дев-сервере.
const C = '/photos/clinic';
const gallery = [
  // --- клиника «Атлас» ---
  // F
  { s: `${C}/procedure-02.webp`,      lg: `${C}/lg/procedure-02.webp`,      w: 600, h: 900, alt: 'Разметка перед процедурой, крупный план' },
  { s: `${C}/consult-01.webp`,        lg: `${C}/lg/consult-01.webp`,        w: 900, h: 600, alt: 'Оксана Чащина размечает зону подбородка на приёме' },
  { s: `${C}/portrait-dark-01.webp`,  lg: `${C}/lg/portrait-dark-01.webp`,  w: 600, h: 900, alt: 'Портрет Оксаны Чащиной' },
  { s: `${C}/interior-02.webp`,       lg: `${C}/lg/interior-02.webp`,       w: 600, h: 900, alt: 'Оксана Чащина в интерьере клиники «Атлас»' },
  { s: `${C}/interior-03.webp`,       lg: `${C}/lg/interior-03.webp`,       w: 900, h: 600, alt: 'Разговор с пациенткой в коридоре клиники' },
  { s: `${C}/consult-03.webp`,        lg: `${C}/lg/consult-03.webp`,        w: 900, h: 600, alt: 'Осмотр перед подбором процедуры' },
  // F
  { s: `${C}/consult-02.webp`,        lg: `${C}/lg/consult-02.webp`,        w: 600, h: 900, alt: 'Разбор плана по анатомической схеме' },
  { s: `${C}/interior-05.webp`,       lg: `${C}/lg/interior-05.webp`,       w: 900, h: 600, alt: 'Беседа с пациенткой в зоне ожидания' },
  { s: `${C}/portrait-dark-02.webp`,  lg: `${C}/lg/portrait-dark-02.webp`,  w: 600, h: 900, alt: 'Портрет Оксаны Чащиной в белом костюме' },
  { s: `${C}/interior-04.webp`,       lg: `${C}/lg/interior-04.webp`,       w: 600, h: 900, alt: 'Путь в кабинет по коридору клиники' },
  { s: `${C}/consult-04.webp`,        lg: `${C}/lg/consult-04.webp`,        w: 900, h: 600, alt: 'Объяснение процедуры на консультации' },
  { s: `${C}/consult-07.webp`,        lg: `${C}/lg/consult-07.webp`,        w: 900, h: 600, alt: 'Оценка тонуса тканей на осмотре' },
  // F — внутри этого блока проходит стык съёмок
  { s: `${C}/portrait-wall-01.webp`,  lg: `${C}/lg/portrait-wall-01.webp`,  w: 600, h: 900, alt: 'Оксана Чащина у графики в холле клиники' },
  { s: `${C}/consult-06.webp`,        lg: `${C}/lg/consult-06.webp`,        w: 900, h: 600, alt: 'Осмотр овала лица' },
  { s: `${C}/portrait-light-01.webp`, lg: `${C}/lg/portrait-light-01.webp`, w: 600, h: 900, alt: 'Студийный портрет Оксаны Чащиной' },

  // --- лайфстайл: уход и быт ---
  { s: '/photos/web/01.webp', w: 1000, h: 1500, alt: 'Средство для домашнего ухода' },
  { s: '/photos/web/03.webp', w: 1000, h: 666,  alt: 'Разбор ухода вдвоём' },
  { s: '/photos/web/05.webp', w: 1000, h: 666,  alt: 'Уход у зеркала' },
  // B
  { s: '/photos/web/02.webp', w: 1000, h: 1500, alt: 'Подбор домашнего ухода' },
  { s: '/photos/web/04.webp', w: 1000, h: 1500, alt: 'Питание и состояние кожи' },
  { s: '/photos/web/08.webp', w: 1000, h: 1500, alt: 'Витамин C в уходе за кожей' },
];
---

<Base
  title="Оксана Чащина — врач-косметолог, специалист превентивной медицины"
  description="Врач-косметолог, дерматолог, физиотерапевт. Практика с 2003 года: аппаратные и инъекционные методы, работа с кожей и с внутренними причинами её состояния. Приём в клинике «Атлас», Москва."
>
  <!-- Разметка для поисковиков: кто принимает, по какому профилю и где.
       Только то, что есть на самой странице, — выдумывать поля нельзя,
       расхождение с видимым текстом поисковики считают за обман. -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Physician',
    name: 'Оксана Чащина',
    jobTitle: 'Врач-косметолог, дерматолог, физиотерапевт',
    url: 'https://chashchina.com/',
    image: 'https://chashchina.com/og-cover.jpg',
    medicalSpecialty: ['Dermatology', 'PreventiveMedicine'],
    telephone: '+7 495 212-08-88',
    areaServed: 'Москва',
    sameAs: [
      'https://t.me/krasotanasspaset',
      'https://vk.com/krasotanasspaset',
      'https://dzen.ru/id/6237172c60d2e66b912c755f',
    ],
    worksFor: {
      '@type': 'MedicalClinic',
      name: 'Клиника «Атлас»',
      url: 'https://atlasesthetics.ru/',
      telephone: '+7 495 212-08-88',
    },
    address: [
      {
        '@type': 'PostalAddress',
        streetAddress: 'Кременчугская улица, 3',
        addressLocality: 'Москва',
        addressCountry: 'RU',
      },
      {
        '@type': 'PostalAddress',
        streetAddress: 'Серпуховский Вал, 21к4',
        addressLocality: 'Москва',
        addressCountry: 'RU',
      },
    ],
  })} />

  <Header />

  <!-- ================= 1. ПЕРВЫЙ ЭКРАН =================
       Скролл-сцена: на старте только фото по центру,
       при прокрутке имя выезжает с боков, затем проявляются
       подзаголовок, отстройка и кнопка записи. -->
  <section class="hero">
    <div class="hero__track" data-hero-track>
      <div class="hero__sticky">
        <div class="hero__frame">
          <canvas class="hero__mol" data-hero-mol aria-hidden="true"></canvas>
          <h1 class="hero__name">
            <span class="hero__word hero__word--l" data-hero-l>Оксана</span>
            <span class="hero__word hero__word--r" data-hero-r>Чащина</span>
          </h1>
          <!-- Это LCP-элемент страницы, поэтому webp и два размера:
               исходный PNG весил 2.4 МБ и один держал больше половины
               веса всей главной. width/height — чтобы место под фото
               резервировалось до загрузки. -->
          <img
            class="hero__photo"
            src="/photos/hero-1200.webp"
            srcset="/photos/hero-780.webp 780w, /photos/hero-1200.webp 1200w"
            sizes="(max-width: 900px) 88vw, 590px"
            width="1200"
            height="1706"
            alt="Оксана Чащина, врач-косметолог"
            fetchpriority="high"
            data-hero-photo
          />
          <div class="hero__bottom" data-hero-bottom>
            <div class="hero__sub">
              <p class="hero__subtitle">
                Врач-косметолог, врач-физиотерапевт, специалист превентивной
                медицины. Практика с 2003 года.
              </p>
              <p class="hero__lead">
                Определённая методика в косметологии (аппараты или инъекции)
                не может решить проблему и проявление старения организма.
                Только индивидуальный longevity-подход может дать своевременный
                и высокоэффективный результат. Для этого нужен опытный врач
                с превентивным методом и глубокими знаниями метаболизма.
              </p>
            </div>
            <div class="hero__cta">
              <BtnPair label="Записаться на консультацию" href="#contact" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 3. ДВЕ ПОЛОВИНЫ ОДНОЙ РАБОТЫ ================= -->
  <section class="halves" id="halves">
    <div class="container halves__inner">
      <span class="tag tag--on-dark mono">Подход</span>
      <h2 class="halves__title">Интегративный взгляд косметолога.</h2>
      <div class="halves__cols">
        <div class="halves__col">
          <span class="halves__label mono">01. Снаружи</span>
          <p>
            Аппаратные и инъекционные методы, подбираемые индивидуально
            на консультации и в процессе многолетнего ведения пациента.
            Все методы воздействия на кожу и мягкие ткани, непосредственно,
            с прогнозируемой физиологичной глубиной воздействия
            и предсказуемым результатом.
          </p>
        </div>
        <div class="halves__col">
          <span class="halves__label mono">02. Изнутри</span>
          <p>
            Хроническое воспаление, окислительный стресс, гликация, дефициты,
            метаболические изменения. Всё, из-за чего кожа стареет быстрее
            и хуже восстанавливается, — можно лечить и восстанавливать
            благодаря современным научным знаниям в сочетании с опытом врача.
          </p>
        </div>
      </div>
      <p class="halves__conclusion">
        Кожа — самый большой орган человека. Работая с ней, мы включаем
        процессы и в окружающих тканях. Поэтому для меня антивозрастная работа —
        работа <mark>с организмом целиком</mark>, а не с отдельной жалобой
        пациента в долгосрочной перспективе.
      </p>
    </div>
  </section>

  <!-- ================= 4. КАК СТРОИТСЯ РАБОТА ================= -->
  <section class="section section--flush-bottom work" id="work">
    <div class="container">
      <span class="tag mono">Как строится работа</span>
      <h2 class="work__title">Почему я не начинаю с лифтинга.</h2>
    </div>
  </section>
  <section class="steps">
    {steps.map((s) => (
      <article class={`steps__panel steps__panel--${s.theme}`}>
        <span class="steps__num mono">{s.n}</span>
        <div class="steps__bottom">
          <h3 class="steps__name">{s.title}</h3>
          {s.text.map((p) => (
            <p class="steps__text">{p}</p>
          ))}
        </div>
      </article>
    ))}
  </section>
  <!-- ================= ПРИНЦИПЫ ================= -->
  <section class="section principles">
    <div class="container">
      <span class="tag mono">Принципы</span>
      <h2 class="principles__title">Что для меня важно.</h2>
      <div class="principles__grid">
        {principles.map((p) => (
          <div class="principles__item">
            <h3>{p.title}</h3>
            <div class="principles__body">
              {p.text.map((t) => (
                <p>{t}</p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= МАНИФЕСТ =================
       Крупная фраза с круглыми фото-вставками между словами.
       Без бирки: фраза сама себе заголовок, пилюля над ней только мешала. -->
  <section class="section section--tight statement">
    <div class="container">
      <p class="statement__text">
        Красивая кожа — это всегда <img class="statement__dot" src="/photos/web/07.webp" alt="" loading="lazy" /> результат
        комплексной работы: ухода, процедур <img class="statement__dot" src="/photos/web/03.webp" alt="" loading="lazy" /> по
        показаниям, питания <img class="statement__dot" src="/photos/web/05.webp" alt="" loading="lazy" /> и здоровья
        организма в целом.
      </p>
    </div>
  </section>

  <!-- ================= 5. АППАРАТНЫЕ МЕТОДЫ =================
       Горизонтальный скролл-слайдер: sticky-сцена, вертикальные
       цветные плашки листаются по скроллу, справа — градиентное
       затухание над невидимыми плашками -->
  <section class="section section--flush-bottom methods" id="methods">
    <div class="container">
      <span class="tag mono">Аппаратные методы</span>
      <h2 class="methods__title">Что происходит с тканями.</h2>
      <p class="methods__intro">
        Ниже — не перечень аппаратов, а объяснение того, что методы
        физиотерапии производят с кожей. Торговые названия имеет смысл
        обсуждать уже на консультации, когда понятна задача.
      </p>
    </div>
  </section>
  <section class="mscroll" data-mscroll>
    <div class="mscroll__track" data-mscroll-track>
      <div class="mscroll__sticky">
        <div class="mscroll__viewport" data-mscroll-viewport>
          <div class="mscroll__row" data-mscroll-row>
            {methods.map((m) => (
              <article class={`mscroll__card mscroll__card--${m.theme}`}>
                <img class="mscroll__img" src={m.img} alt="" loading="lazy" />
                <img class="mscroll__img mscroll__img--blur" src={m.img} alt="" loading="lazy" aria-hidden="true" />
                <div class="mscroll__body">
                  <h3 class="mscroll__name">{m.title}</h3>
                  <p>{m.text}</p>
                  {m.note && <span class="mscroll__note mono">{m.note}</span>}
                </div>
              </article>
            ))}
          </div>
        </div>
        <div class="mscroll__fade" data-mscroll-fade aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- ================= 6. ГРАВИТАЦИОННЫЙ ПТОЗ И SMAS ================= -->
  <section class="smas" id="smas">
    <div class="container smas__inner">
      <div class="smas__text">
        <span class="tag tag--on-dark mono">Гравитационный птоз</span>
        <h2 class="smas__title">Провисает не кожа — каркас, на котором она держится.</h2>
        <p class="smas__lead">
          С возрастом провисает не столько кожа, сколько то, на чём она
          держится — внутренний каркас лица. Поэтому кремы и поверхностные
          процедуры на овал почти не влияют: они работают выше,
          а проблема глубже.
        </p>
        <p class="smas__body">
          Фокусированный ультразвук — способ дотянуться до этого слоя
          без хирургии. Что именно происходит с тканями, когда ждать
          результат и кому метод не подходит — разбираем на консультации.
        </p>
        <BtnPair label="Обсудить на консультации" href="#contact" />
      </div>
      <figure class="smas__media">
        <!-- src подставляется скриптом, когда секция подъезжает к экрану:
             до этого видно постер. Иначе оба ролика (1.6 МБ) грузятся
             сразу вместе с первым экраном, хотя лежат глубоко внизу. -->
        <video data-lazy-video="/video/ripple.mp4" poster="/video/ripple-poster.webp" autoplay muted loop playsinline preload="none"></video>
      </figure>
    </div>
  </section>

  <!-- ================= 7. ИНЪЕКЦИОННЫЕ МЕТОДЫ ================= -->
  <section class="section inject" id="inject">
    <div class="container">
      <span class="tag mono">Инъекционные методы</span>
      <h2 class="inject__title">Чего можно достичь.</h2>
      <p class="inject__intro">
        Говорю не о препаратах, а о задачах. Препарат подбирается под задачу,
        а не наоборот.
      </p>
      <figure class="inject__media">
        <img
          src="/photos/clinic/lg/procedure-01.webp"
          alt="Инъекционная процедура: работа по разметке"
          width="1440"
          height="960"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="inject__grid">
        {tasks.map((t) => (
          <article class="inject__item">
            <span class="inject__num mono">{t.n}</span>
            <div>
              <h3 class="inject__name">{t.title}</h3>
              <p>{t.text}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="inject__closing">
        Инъекции не заменяют лифтинг, не меняют черты лица и не отменяют
        ухода — <mark>это инструмент, а не волшебство</mark>.
      </p>
    </div>
  </section>

  <!-- ================= 8. ЗОНЫ, КОТОРЫЕ ВЫДАЮТ ВОЗРАСТ ================= -->
  <section class="section zones" id="zones">
    <div class="container">
      <span class="tag mono">Зоны, которые выдают возраст</span>
      <h2 class="zones__title">Лицо ещё держится, а шея выдаёт.</h2>
      <p class="zones__intro">
        Возраст читается не по лбу и не по носогубным складкам. Первыми выдают
        шея, зона декольте, кисти рук — и именно им обычно достаётся меньше
        всего внимания.
      </p>
      <div class="zones__list">
        <div class="zones__item">
          <h3>Шея и кольца Венеры</h3>
          <p>
            Кожа здесь тоньше, сальных желёз меньше, а нагрузки от экранов —
            больше, поэтому шея стареет раньше лица. Что из этого генетика,
            а что привычки — видно на осмотре, и от этого зависит план.
          </p>
        </div>
        <div class="zones__item">
          <h3>Второй подбородок</h3>
          <p>
            Причины разные: лишний объём, слабый тонус тканей, особенности
            анатомии. Часть случаев решается аппаратами — и я честно говорю,
            где проходит граница с хирургией.
          </p>
        </div>
        <div class="zones__item">
          <h3>Кисти, локти, колени</h3>
          <p>
            Зоны, которым достаётся меньше всего ухода. Здесь работает
            плотность и качество кожи: уплотняющие методики и защита
            от солнца дают больше, чем любой крем.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 9. КРАСОТА НАЧИНАЕТСЯ НЕ С КРЕМА ================= -->
  <section class="section inside" id="inside">
    <div class="container inside__inner">
      <figure class="inside__media">
        <video data-lazy-video="/video/serum.mp4" poster="/video/serum-poster.webp" autoplay muted loop playsinline preload="none"></video>
      </figure>
      <div class="inside__text">
        <span class="tag mono">Изнутри</span>
        <h2 class="inside__title">Красота начинается не с крема.</h2>
        <p>
          Про это я много пишу у себя в канале: состояние кожи во многом
          определяется тем, что происходит внутри. Хроническое воспаление,
          окислительный стресс, состояние кишечника, дефициты, качество сна —
          всё это отражается на лице раньше, чем мы связываем одно с другим.
        </p>
        <p>
          Я не верю в одну молекулу, которая решит все проблемы. Красивая
          кожа — это всегда результат комплексной работы: домашнего ухода,
          процедур по показаниям, питания, образа жизни и здоровья организма
          в целом.
        </p>
        <p>
          В телеграм-канале я разбираю это в живом формате: коротко и по делу —
          состав средства, свежее исследование, вопрос с приёма. На сайте
          собран весь архив канала.
        </p>
        <BtnPair label="Читать блог" href="/blog/" />
      </div>
    </div>
  </section>

  <!-- ================= 12. СОЦСЕТИ ================= -->
  <!-- ================= 10. ДОМАШНИЙ УХОД ================= -->
  <section class="section care" id="care">
    <div class="container">
      <span class="tag mono">Домашний уход</span>
      <h2 class="care__title">Я рекомендую.</h2>
      <div class="care__cols">
        <div class="care__text">
          <p>
            Домашний уход иногда решает больше, чем процедуры: он работает
            каждый день, а не раз в месяц. Но вокруг него столько маркетинга,
            что разобраться самостоятельно почти невозможно.
          </p>
          <p>
            Я подбираю уход под задачу и тип кожи, а не под обещания на упаковке.
            Чаще всего это марки с дерматологической школой и понятным составом —
            те, которыми пользуюсь сама и которые советую пациентам на приёме.
          </p>
          <div class="care__brand">
            <img
              class="care__logo"
              src="/photos/brands/naos.png"
              alt="NAOS"
              width="427"
              height="85"
              loading="lazy"
            />
            <span class="care__brands">
              Официальный дистрибьютор Bioderma, Institut Esthederm и État Pur
              в России.
            </span>
          </div>
        </div>
        <figure class="care__media">
          <img
            src="/photos/web/06.webp"
            alt="Подбор домашнего ухода на приёме"
            width="1000"
            height="666"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ================= 11. ВИДЕО =================
       Ролики из инстаграма Оксаны, лежат своими файлами (h264 + faststart).
       Грузятся ТОЛЬКО по клику: автоплей четырёх вертикалок стоил бы
       ~14 МБ на скролл, а так первый экран не дорожает вовсе — до клика
       на странице лежит один постер весом ~40 КБ. -->
  <section class="section reels" id="video">
    <div class="container">
      <span class="tag mono">Видео</span>
      <h2 class="reels__title">Как я объясняю.</h2>
      <p class="reels__lead">
        Короткие ответы на вопросы, которые чаще всего задают на приёме.
      </p>
      <div class="reels__row">
        {reels.map((r) => (
          <article class="reels__card">
            <!-- Постер отдельной картинкой, а не атрибутом poster:
                 poster грузится вместе со страницей, loading="lazy" — только
                 когда блок подъезжает к экрану -->
            <img
              class="reels__poster"
              src={r.poster}
              alt=""
              width="540"
              height="960"
              loading="lazy"
              decoding="async"
            />
            <video
              class="reels__video"
              data-reel={r.src}
              playsinline
              preload="none"
            ></video>
            <button class="reels__play" type="button" aria-label="Смотреть видео">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M8 5v14l11-7z" fill="currentColor" />
              </svg>
            </button>
            <!-- Свой пульт вместо нативного: у браузерного своя палитра
                 и свои иконки, на фирменной плашке он читается чужим.
                 Появляется после запуска, прячется вместе с курсором. -->
            <div class="reels__ui" hidden>
              <button class="reels__toggle" type="button" aria-label="Пауза">
                <svg class="reels__i-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor" />
                </svg>
                <svg class="reels__i-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
                  <path d="M8 5v14l11-7z" fill="currentColor" />
                </svg>
              </button>
              <div
                class="reels__bar"
                role="slider"
                tabindex="0"
                aria-label="Перемотка"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
              >
                <div class="reels__fill"></div>
              </div>
              <button class="reels__sound" type="button" aria-label="Выключить звук">
                <svg class="reels__i-on" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 9v6h4l5 4V5L8 9H4zm12 3a4 4 0 0 0-2-3.5v7A4 4 0 0 0 16 12z" fill="currentColor" />
                </svg>
                <svg class="reels__i-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
                  <path d="M4 9v6h4l5 4V5L8 9H4zm11 .5 1.4-1.4 5 5-1.4 1.4-5-5z" fill="currentColor" />
                </svg>
              </button>
              <button class="reels__full" type="button" aria-label="На весь экран">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 9V4h5v2H6v3H4zm11-5h5v5h-2V6h-3V4zM4 15h2v3h3v2H4v-5zm14 0h2v5h-5v-2h3v-3z" fill="currentColor" />
                </svg>
              </button>
            </div>
