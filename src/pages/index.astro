<style>
  /* ================= 1. ПЕРВЫЙ ЭКРАН =================
     Светлый, без плашки: фото по центру на канвасе страницы */
  .hero__track {
    /* длина скролл-сцены: 1 экран статики + ~1.6 экрана анимации */
    height: 260svh;
  }
  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
  }
  .hero__frame {
    position: relative;
    height: 100%;
    overflow: hidden;
  }
  /* Молекулы: канвас с точками и связями, тухнет к низу, чтобы не лезть на фото */
  .hero__mol {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 96%);
    mask-image: linear-gradient(to bottom, #000 62%, transparent 96%);
  }
  /* Фото — акцент, строго по центру, прижато к низу рамки */
  .hero__photo {
    position: absolute;
    left: 50%;
    bottom: 0;
    translate: -50% 0;
    height: min(92%, 840px);
    width: auto;
    object-fit: contain;
    object-position: bottom;
    z-index: 2;
  }
  /* Имя гигантским кеглем, слова по бокам от фото, ПОД фотографией по z */
  .hero__name {
    position: absolute;
    inset: 0;
    z-index: 1;
    color: var(--ink);
  }
  .hero__word {
    position: absolute;
    font-size: clamp(3.4rem, 10.5vw, 12rem);
    line-height: 1;
    letter-spacing: var(--track-hero);
    will-change: transform, opacity;
  }
  .hero__word--l {
    left: var(--gutter);
    top: 14%;
    transform: translateX(-110vw);
  }
  .hero__word--r {
    right: var(--gutter);
    top: 36%;
    transform: translateX(110vw);
  }
  .hero__bottom {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(28px, 4vh, 44px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    opacity: 0;
    transform: translateY(40px);
    will-change: transform, opacity;
  }
  .hero__subtitle {
    font-size: var(--text-lead);
    color: var(--ink);
    max-width: 34ch;
    margin-bottom: 16px;
  }
  .hero__lead {
    color: var(--ink);
    max-width: 44ch;
  }
  .hero__cta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-shrink: 0;
  }
  /* Без анимаций — сразу финальное состояние */
  @media (prefers-reduced-motion: reduce) {
    .hero__track { height: auto; }
    .hero__sticky { position: static; height: 100svh; }
    .hero__word--l, .hero__word--r { transform: none; }
    .hero__bottom { opacity: 1; transform: none; }
  }

  /* ================= 3. ДВЕ ПОЛОВИНЫ ================= */
  .halves {
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-frame);
    margin-inline: 12px;
    padding-block: var(--section-gap);
  }
  .halves__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin: 12px 0 clamp(32px, 5vw, 64px);
  }
  /* Без плашек: колонки держит сетка и вертикальный ритм */
  .halves__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 72px);
  }
  .halves__col p {
    font-size: clamp(1.1rem, 1.5vw, 1.375rem);
    letter-spacing: var(--track-heading);
    line-height: 1.3;
    max-width: 44ch;
  }
  .halves__label {
    display: block;
    margin-bottom: 20px;
  }
  .halves__conclusion {
    margin-top: clamp(40px, 6vw, 88px);
    font-size: clamp(1.35rem, 2.2vw, 1.9rem);
    letter-spacing: var(--track-heading);
    line-height: 1.25;
    max-width: 46ch;
  }

  /* ================= 4. КАК СТРОИТСЯ РАБОТА ================= */
  .work__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 12px;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(28px, 4vw, 48px);
  }
  .steps__panel {
    min-height: clamp(380px, 50vh, 520px);
    padding: 28px var(--gutter) 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
  }
  .steps__panel--lime { background: var(--lime); color: var(--ink); }
  .steps__panel--ink { background: var(--ink); color: var(--paper); }
  .steps__panel--frost { background: var(--tissue); color: var(--ink); }
  .steps__num {
    align-self: flex-end;
  }
  .steps__name {
    font-size: var(--text-card-title);
    letter-spacing: var(--track-heading);
    margin-bottom: 14px;
  }
  .steps__text {
    max-width: 52ch;
  }
  .steps__text + .steps__text {
    margin-top: 12px;
  }

  /* ================= ПРИНЦИПЫ ================= */
  .principles__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 12px;
  }
  /* Редакционные строки: крупный заголовок слева, текст справа.
     Держит вертикальный ритм, без карточек и линий */
  .principles__grid {
    display: flex;
    flex-direction: column;
    /* Просвет больше, чем был у однофразовых принципов: теперь у каждого
       по два абзаца, и на прежних 22–32px строки слипались */
    gap: clamp(32px, 4vw, 56px);
    margin-top: var(--block-gap);
  }
  .principles__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(20px, 3vw, 48px);
    align-items: start;
  }
  .principles__item h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    letter-spacing: var(--track-heading);
    line-height: 1.15;
  }
  .principles__item p {
    max-width: var(--measure-text);
  }
  .principles__item p + p {
    margin-top: 12px;
  }

  /* ================= 5. АППАРАТНЫЕ МЕТОДЫ ================= */
  .methods__title,
  .inject__title,
  .press__title,
  .reviews__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 12px;
  }
  .methods__intro,
  .inject__intro,
  .press__intro,
  .reviews__intro {
    font-size: var(--text-lead);
    max-width: var(--measure-lead);
    margin-top: 20px;
  }
  /* Скролл-слайдер с вертикальными плашками */
  .mscroll {
    /* съедаем пустоту от вертикальной центровки плашек в 100svh-сцене —
       симметрично сверху и снизу */
    margin-block: calc(-1 * clamp(32px, 8svh, 80px));
  }
  .mscroll__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .mscroll__viewport {
    position: relative;
    width: 100%;
    padding-inline: var(--gutter);
  }
  .mscroll__row {
    display: flex;
    gap: 20px;
    width: max-content;
    will-change: transform;
  }
  /* Вертикальная плашка: фото во всю площадь, текст поверх скрима */
  .mscroll__card {
    position: relative;
    width: clamp(300px, 36vw, 480px);
    height: min(80svh, 780px);
    border-radius: var(--radius-card);
    padding: 28px 28px 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    overflow: hidden;
  }
  .mscroll__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mscroll__card--dark { background: var(--ink); color: var(--paper); }
  .mscroll__card--light { background: var(--tissue); color: var(--ink); }
  /* Низ фото плавно «утопает» в матовом стекле: поверх лежит размытая
     копия того же фото, маска растворяет её кверху. Без рамок.
     filter считается один раз и кешируется — в отличие от backdrop-filter */
  .mscroll__img--blur {
    filter: blur(18px);
    transform: scale(1.08);
    -webkit-mask-image: linear-gradient(to bottom, transparent 46%, #000 72%);
    mask-image: linear-gradient(to bottom, transparent 46%, #000 72%);
  }
  /* лёгкая тонировка снизу, чтобы текст дочитывался */
  .mscroll__card::after {
    content: '';
    position: absolute;
    inset: 50% 0 0;
    z-index: 0;
    pointer-events: none;
  }
  /* лёгкая тонировка в цвет темы, чтобы текст дочитывался */
  .mscroll__card--dark::after {
    background: linear-gradient(to bottom, transparent, rgba(20, 30, 30, 0.38));
  }
  .mscroll__card--light::after {
    background: linear-gradient(to bottom, transparent, rgba(247, 247, 245, 0.5));
  }
  .mscroll__body {
    position: relative;
    z-index: 1;
    margin-top: auto;
  }
  .mscroll__name {
    font-size: var(--text-card-title);
    letter-spacing: var(--track-heading);
    margin-bottom: 12px;
  }
  .mscroll__card p {
    max-width: 40ch;
  }
  /* Служебная метка механизма под абзацем: mono, лаймом — как подпись,
     а не как продолжение текста */
  .mscroll__note {
    display: block;
    margin-top: 14px;
    color: var(--lime);
  }
  /* Градиент, «закрывающий» плашки за правым краем */
  .mscroll__fade {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: clamp(140px, 16vw, 280px);
    background: linear-gradient(to left, var(--bone) 12%, transparent);
    pointer-events: none;
  }
  /* Мобильный и reduced-motion: обычный горизонтальный скролл пальцем */
  @media (max-width: 900px), (prefers-reduced-motion: reduce) {
    .mscroll {
      /* На мобиле сцены нет — нужны обычные отступы. Снизу это особенно важно:
         дальше идёт тёмная плашка SMAS со своим фоном, и при нуле последняя
         фото-плашка упиралась прямо в неё. */
      margin-block: var(--section-gap-tight) var(--section-gap);
    }
    .mscroll__track {
      height: auto !important;
    }
    .mscroll__sticky {
      position: static;
      height: auto;
      overflow: visible;
    }
    .mscroll__viewport {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .mscroll__viewport::-webkit-scrollbar {
      display: none;
    }
    .mscroll__row {
      transform: none !important;
    }
    .mscroll__card {
      width: min(78vw, 420px);
      height: min(64svh, 560px);
    }
    .mscroll__fade {
      display: none;
    }
  }

  /* Навигация под плашками */
  .methods__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
  }
  .methods__btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--sage);
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .methods__btn:hover {
    background: var(--lime);
    border-color: var(--lime-2);
    transform: scale(1.06);
  }
  .methods__btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
    background: var(--paper);
    border-color: var(--sage);
  }
  .methods__dots {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .methods__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--sage);
    cursor: pointer;
    transition: background 0.3s var(--ease), width 0.3s var(--ease), border-radius 0.3s var(--ease);
  }
  .methods__dot.is-active {
    width: 24px;
    border-radius: 4px;
    background: var(--ink);
  }

  @media (max-width: 768px) {
    .methods__card {
      flex: 0 0 calc(85vw - var(--gutter));
      width: calc(85vw - var(--gutter));
      min-height: 360px;
    }
  }
  /* ================= МАНИФЕСТ ================= */
  .statement {
    text-align: center;
  }
  .statement__text {
    font-size: clamp(1.7rem, 3.2vw, 2.9rem);
    letter-spacing: var(--track-display);
    line-height: 1.25;
    max-width: 30ch;
    margin-inline: auto;
  }
  /* Кругляш-вставка размером с букву, сидит на строке */
  .statement__dot {
    display: inline-block;
    width: 1.1em;
    height: 1.1em;
    border-radius: 50%;
    object-fit: cover;
    vertical-align: -0.18em;
    margin-inline: 0.06em;
  }

  /* ================= 6. SMAS ================= */
  .smas {
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-frame);
    margin-inline: 12px;
    padding-block: var(--section-gap);
  }
  .smas__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 72px);
    align-items: center;
  }
  .smas__title {
    font-size: clamp(1.9rem, 3.2vw, 3rem);
    letter-spacing: var(--track-display);
    line-height: 1.12;
    max-width: 24ch;
    margin: 12px 0 clamp(20px, 3vw, 32px);
  }
  .smas__lead {
    font-size: var(--text-lead);
    max-width: 48ch;
    margin-bottom: 16px;
  }
  .smas__body {
    max-width: 52ch;
    margin-bottom: clamp(24px, 3vw, 36px);
  }
  /* На тёмном канвасе кнопка светлая — правило референса */
  .smas :global(.btn-pair__label) {
    background: var(--paper);
    color: var(--ink);
  }
  .smas :global(.btn-pair__corner) {
    color: var(--paper);
  }
  .smas__media {
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .smas__media video {
    display: block;
    width: 100%;
    aspect-ratio: var(--media-ratio);
    object-fit: cover;
  }

  /* ================= 7. ИНЪЕКЦИОННЫЕ МЕТОДЫ ================= */
  /* Полоса-иллюстрация между интро и сеткой задач. Кадр крупноплановый,
     поэтому пропорция узкая: широкий срез по центру берёт лицо и руку,
     а всё лишнее по краям уходит. Источник — 1440px из clinic/lg. */
  .inject__media {
    margin-top: var(--block-gap);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .inject__media img {
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }
  .inject__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px) clamp(24px, 4vw, 72px);
    margin-top: var(--block-gap);
  }
  .inject__item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .inject__num {
    flex-shrink: 0;
    margin-top: 0.4em;
    color: var(--graphite);
  }
  .inject__name {
    font-size: var(--text-card-title);
    letter-spacing: var(--track-heading);
    margin-bottom: 12px;
  }
  .inject__item p {
    max-width: 44ch;
  }
  .inject__closing {
    margin-top: clamp(40px, 6vw, 72px);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    letter-spacing: var(--track-heading);
    line-height: 1.3;
    max-width: 40ch;
  }

  /* ================= 9. НЕ С КРЕМА ================= */
  .inside__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(28px, 4vw, 72px);
    align-items: center;
  }
  .inside__media {
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .inside__media video {
    display: block;
    width: 100%;
    aspect-ratio: var(--media-ratio);
    object-fit: cover;
  }
  .inside__title {
    font-size: clamp(1.9rem, 3.2vw, 3rem);
    letter-spacing: var(--track-display);
    line-height: 1.12;
    max-width: 22ch;
    margin: 12px 0 clamp(20px, 3vw, 28px);
  }
  .inside__text p {
    max-width: 52ch;
  }
  .inside__text p + p {
    margin-top: 14px;
  }
  .inside__text :global(.btn-pair) {
    margin-top: clamp(24px, 3vw, 36px);
  }

  /* ================= 13. ПРЕССА =================
     :global() обязателен: класс висит на корневом <a> компонента BtnPair,
     у которого свой astro-scope — без него отступ молча не применяется
     (кнопка прилипает к сетке публикаций). */
  :global(.press__all) {
    margin-top: clamp(28px, 3.4vw, 44px);
  }
  /* Сцена прессы: механика и плашки — общие с аппаратными методами
     (.mscroll__*), здесь только то, чем карточка-ссылка отличается от
     карточки метода. Плашки уже, чем у методов: заголовок публикации
     короче текста метода, и в кадр помещается на одну больше. */
  .press__scene :global(.mscroll__card) {
    width: clamp(280px, 26vw, 380px);
    height: min(72svh, 640px);
    text-decoration: none;
    color: var(--paper);
  }
  /* Мета и заголовок приходят из данных, чип — из компонента ArrowChip:
     до них scoped-правило достаёт только через :global */
  .press__scene :global(.pcard__meta) {
    display: block;
    color: var(--lime);
    margin-bottom: 10px;
  }
  .press__scene :global(.pcard__title) {
    display: block;
    font-size: var(--text-card-title);
    letter-spacing: var(--track-heading);
    line-height: 1.15;
  }
  .press__scene :global(.pcard__chip) {
    margin-top: 18px;
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }
  .press__scene :global(.mscroll__card:hover) :global(.pcard__chip),
  .press__scene :global(.mscroll__card:focus-visible) :global(.pcard__chip) {
    opacity: 1;
  }
  .press__scene :global(.mscroll__card:focus-visible) {
    outline: 2px solid var(--lime-2);
    outline-offset: 4px;
  }

  /* ================= 16. ОТЗЫВЫ ================= */
  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: var(--block-gap);
  }
  .reviews__card {
    background: var(--paper);
    border-radius: var(--radius-card);
    padding: 24px 24px 32px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }
  .reviews__num {
    display: block;
  }
  .reviews__stat {
    display: block;
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1;
  }
  .reviews__label {
    display: block;
    margin-top: 10px;
    max-width: 24ch;
  }
  /* Тёмная карточка-добор: остальные площадки без цифр — там отзывов
     ещё мало, крупный «рейтинг 5,0 по одному отзыву» выглядел бы враньём */
  .reviews__card--dark {
    background: var(--ink);
    color: #fff;
  }
  .reviews__more {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .reviews__more-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    transition: color 0.25s var(--ease);
  }
  .reviews__more-link:hover {
    color: var(--lime);
  }
  .reviews__more-name {
    font-size: var(--text-card-title);
    letter-spacing: var(--track-heading);
  }
  /* ================= 8. ЗОНЫ ================= */
  .zones__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 12px;
  }
  .zones__intro {
    font-size: var(--text-lead);
    max-width: var(--measure-lead);
    margin-top: 20px;
  }
  .zones__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 72px);
    margin-top: var(--block-gap);
  }
  .zones__item h3 {
    font-size: var(--text-card-title);
    letter-spacing: var(--track-heading);
    margin-bottom: 14px;
  }

  /* ================= 10. ДОМАШНИЙ УХОД ================= */
  .care__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 12px;
  }
  /* Слева текст и следом логотип дистрибьютора, справа — кадр
     из лайфстайл-съёмки на всю высоту колонки. Тема бытовая, поэтому
     и съёмка бытовая: клинические кадры работают в секциях про приём.
     stretch, а не start: иначе правая колонка кончается выше левой
     и под текстом остаётся пустая четверть блока. */
  .care__cols {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    /* Ряд и колонка разведены нарочно. 88px хороши МЕЖДУ колонками, но на
       телефоне колонки схлопываются в одну — и тот же зазор превращается
       в дыру, из-за которой фото читается отдельным блоком, а не частью
       секции. По вертикали внутри блока работает --block-gap. */
    gap: var(--block-gap) clamp(28px, 5vw, 88px);
    margin-top: var(--block-gap);
    align-items: stretch;
  }
  .care__text p {
    max-width: 52ch;
  }
  .care__text p + p {
    margin-top: 16px;
  }
  .care__media {
    border-radius: var(--radius-card);
    overflow: hidden;
    /* Пол на случай, если текст слева окажется коротким */
    min-height: clamp(300px, 26vw, 420px);
  }
  .care__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Дистрибьютор: логотип и подпись, без плашки и без ссылки */
  .care__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-top: clamp(28px, 3.4vw, 44px);
  }
  .care__logo {
    width: min(100%, clamp(240px, 28vw, 380px));
    height: auto;
  }
  .care__brands {
    max-width: 34ch;
  }

  /* ================= 11. ВИДЕО ================= */
  .reels__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 12px;
  }
  .reels__lead {
    font-size: var(--text-lead);
    max-width: var(--measure-lead);
    margin-top: 16px;
  }
  /* Четыре вертикали влезают в ряд на десктопе; на узком экране ряд
     превращается в ленту со свайпом (медиазапрос ниже) */
  .reels__row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 20px);
    margin-top: var(--block-gap);
  }
  .reels__card {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 20px;
    overflow: hidden;
    background: var(--ink);
  }
  .reels__poster,
  .reels__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Постер лежит поверх пустого video и уходит, когда ролик запущен */
  .reels__poster {
    position: absolute;
    inset: 0;
    max-width: none;
  }
  .reels__card.is-playing .reels__poster {
    display: none;
  }
  /* Лаймовый чип со стрелкой воспроизведения — тот же приём, что у ArrowChip.
     Пропадает, когда ролик запущен: дальше управление отдаём нативным controls */
  .reels__play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 8px;
    background: var(--lime);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.25s var(--ease);
  }
  .reels__play:hover {
    background: var(--lime-2);
  }
  .reels__play svg {
    width: 26px;
    height: 26px;
  }
  .reels__card.is-playing .reels__play {
    display: none;
  }
  /* Пульт: стеклянная плашка внизу карточки — тот же приём, что в шапке
     и на фото-плашках слайдера. Лайм только в заливке полосы */
  .reels__ui {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 12px;
    background: rgba(34, 47, 48, 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }
  /* Показываем по наведению и на паузе; на тач-экранах ховера нет,
     поэтому там пульт видно всегда (медиазапрос ниже) */
  .reels__card:hover .reels__ui,
  .reels__card:focus-within .reels__ui,
  .reels__card.is-paused .reels__ui {
    opacity: 1;
  }
  .reels__ui button {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--paper);
    cursor: pointer;
    transition: color 0.25s var(--ease);
  }
  .reels__ui button:hover {
    color: var(--lime);
  }
  .reels__ui svg {
    width: 18px;
    height: 18px;
  }
  /* Атрибут hidden — из HTML, и на SVG браузер его не применяет: без этого
     правила в кнопке видно СРАЗУ обе иконки, и пульт разъезжается в два ряда */
  .reels__ui svg[hidden] {
    display: none;
  }
  /* Сама полоса 3px, но зона попадания — все 12px высоты элемента,
     иначе в неё не прицелиться ни мышью, ни пальцем */
  .reels__bar {
    flex: 1;
    height: 12px;
    display: flex;
    align-items: center;
    cursor: pointer;
    background: linear-gradient(rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0.35))
      center / 100% 3px no-repeat;
  }
  .reels__fill {
    height: 3px;
    width: 0;
    background: var(--lime);
  }
  /* На тач-экранах ховера нет — пульт держим на виду */
  @media (hover: none) {
    .reels__card.is-playing .reels__ui {
      opacity: 1;
    }
  }
  /* В полноэкранном режиме карточка перестаёт быть вертикальной плашкой:
     кадр вписываем целиком, чтобы не срезать края */
  .reels__card:fullscreen {
    aspect-ratio: auto;
    width: 100%;
    height: 100%;
    border-radius: 0;
  }
  .reels__card:fullscreen .reels__video {
    object-fit: contain;
  }

  /* ================= 12. СОЦСЕТИ ================= */
  .social {
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-frame);
    margin-inline: 12px;
    padding-block: var(--section-gap);
  }
  .social__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 88px);
    align-items: center;
  }
  .social__title {
    font-size: var(--text-heading);
    letter-spacing: var(--track-heading);
    line-height: 1.15;
    max-width: 24ch;
    margin-block: 12px 20px;
  }
  .social__lead {
    max-width: 44ch;
  }
  .social__links {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 12px;
  }
  /* Строка-ссылка: имя + адрес, ховер подсвечивает лаймом */
  /* Компактный чип по содержимому: имя, под ним адрес */
  .social__link {
    display: inline-flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px;
    border: 1px solid var(--sea);
    border-radius: var(--radius-card);
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .social__link:hover {
    border-color: var(--lime);
    background: rgba(206, 247, 158, 0.06);
  }
  .social__name {
    font-size: var(--text-card-title);
    letter-spacing: var(--track-heading);
  }

  /* ================= 14. ОБО МНЕ ================= */
  .about__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 12px;
  }
  /* Верх секции — одна горизонтальная строка: портрет-кругляшок, описание,
     цитата. Высокий кадр 4:5 рядом с текстом растягивал блок на пол-экрана,
     поэтому фото ужато до аватара, а текст разложен в две равные колонки. */
  .about__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 3.4vw, 56px);
    margin-top: clamp(28px, 4vw, 52px);
    align-items: start;
  }
  .about__avatar {
    /* На 1280 это ~240px. Выше поднимать некуда: аватар ест ширину у двух
       текстовых колонок, а они на этом вьюпорте и так по ~440px. */
    width: clamp(150px, 19vw, 240px);
    /* height: auto обязателен: атрибуты width/height у <img> работают как
       презентационная подсказка и без сброса высоты картинка встаёт в свои
       440px, а aspect-ratio молча не применяется. В global.css сброса нет. */
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    background: var(--tissue);
  }
  .about__text p + p {
    margin-top: 14px;
  }
  /* Цитата — третья колонка, поэтому кегль ниже прежнего: на ~470px ширины
     26px давали строку в 30 знаков, то есть рубленый столбик. */
  .about__closing {
    font-size: clamp(1.15rem, 1.45vw, 1.35rem);
    letter-spacing: var(--track-heading);
    line-height: 1.3;
  }

  /* ---------- Таймлайн образования и практики ----------
     Сетка: одна колонка = один год. Запись занимает свои годы
     (--col — год начала, --span — длительность), но подпись шире ячейки и
     свободно вылезает вправо — поэтому соседей по годам разводим по этажам
     (--lane), см. комментарий у данных во фронтматтере. */
  .cv {
    /* Ширина года — главная ручка длины ленты. 30 лет × 72px ≈ 2160px,
       то есть ~1,7 экрана на вьюпорте 1280. Диапазон кручения: 44–90px. */
    --cv-year: clamp(44px, 5.6vw, 72px);
    /* Ширина подписи. Потолок 196px не случайный: 2010 и 2013 стоят на одном
       этаже в трёх годах друг от друга (216px), карточка шире оставит между
       ними щель в пару пикселей. Поднимаете потолок — разводите их по этажам. */
    --cv-card: clamp(150px, 15vw, 196px);
    margin-top: clamp(40px, 5vw, 72px);
  }
  .cv__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }
  /* Подсказка и затухание гаснут, когда лента домотана до конца.
     Класс висит на корне .cv: подсказка живёт в шапке, а не внутри .cv__stage,
     и селектор от сцены до неё не достаёт. */
  .cv__hint {
    transition: opacity 0.3s var(--ease);
  }
  .cv.is-end .cv__hint {
    opacity: 0;
  }

  .cv__stage {
    position: relative;
  }
  .cv__scroll {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    cursor: grab;
    /* Левый край ленты встаёт по сетке .container, правый уходит в край экрана.
       Считаем от 100% блока, а не от 100vw: вьюпортные единицы включают
       полосу прокрутки и лента разъезжается с контентом на пару пикселей. */
    padding-left: max(var(--gutter), calc((100% - var(--page-max)) / 2 + var(--gutter)));
    padding-right: var(--gutter);
    padding-block: 4px;
  }
  .cv__scroll.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }
  .cv__scroll:focus-visible {
    outline: 2px solid var(--lime-2);
    outline-offset: 4px;
  }
  .cv__grid {
    display: grid;
    /* 1–2 — образование (этаж 2 выше), 3 — ось, 4–5 — практика */
    grid-template-rows: auto auto 14px auto auto;
    row-gap: 10px;
    width: max-content;
    padding-right: 24px; /* хвост после 2026-го, чтобы ось не упиралась в обрез */
  }

  /* Ось и точки событий */
  .cv__axis {
    grid-row: 3;
    grid-column: 1 / -1;
    align-self: center;
    height: 1px;
    background: var(--sage);
  }
  .cv__dot {
    grid-row: 3;
    grid-column: var(--col);
    justify-self: start;
    align-self: center;
    width: 9px;
    height: 9px;
    margin-left: -4px;
    border-radius: 2px;
    background: var(--lime-2);
  }

  /* Запись таймлайна */
  .cv__item {
    grid-column: var(--col) / span var(--span);
    display: flex;
    flex-direction: column;
    gap: 4px;
    /* Запись не уже --cv-card, но длинные периоды растягиваются на свои годы:
       так длительность видно шириной подписи, без отдельной полосы.
       −16px — зазор, чтобы соседние периоды не смыкались вплотную. */
    width: max(var(--cv-card), calc(var(--span) * var(--cv-year) - 16px));
    padding-left: 12px;
    border-left: 1px solid var(--sage);
  }
  /* Ряд считаем в шаблоне, а не через calc() в grid-row: номер линии сетки —
     это <integer>, и calc() там поддержан не везде. */
  .cv__item--edu {
    grid-row: var(--row);
    align-self: end;
  }
  .cv__item--work {
    grid-row: var(--row);
    align-self: start;
  }
  .cv__years {
    color: var(--ink);
  }
  .cv__place {
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .cv__note {
    font-size: 0.85rem;
    line-height: 1.25;
  }
  /* Затухание у правого обреза — «лента продолжается» */
  .cv__fade {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: clamp(60px, 8vw, 140px);
    background: linear-gradient(to left, var(--bone) 20%, transparent);
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.3s var(--ease);
  }
  .cv.is-end .cv__fade {
    opacity: 0;
  }

  .cv__certs {
    margin-top: clamp(12px, 1.6vw, 20px);
  }
  .cv__certs-head {
    display: block;
    margin-bottom: 12px;
  }
  .cv__certs p {
    max-width: var(--measure-text);
  }
  .cv__certs p + p {
    margin-top: 10px;
  }

  /* ================= 17. ГДЕ Я ПРИНИМАЮ =================
     Тёмная плашка на месте бывшей формы записи. Слева — справка
     о клинике, справа — контакты. Формы нет, персональные данные
     сайт не собирает. */
  .clinic {
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-frame);
    margin-inline: 12px;
    padding-block: var(--section-gap);
  }
  .clinic__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 88px);
    margin-top: var(--block-gap);
    align-items: start;
  }
  /* Заголовок и телефон — первые элементы своих колонок, верх у них общий */
  .clinic__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-bottom: 24px;
  }
  .clinic__logo {
    width: clamp(150px, 14vw, 190px);
    height: auto;
    display: block;
  }
  .clinic__lead {
    font-size: var(--text-lead);
    max-width: var(--measure-lead);
    margin-top: 20px;
  }
  .clinic__about {
    max-width: 52ch;
    margin-top: 14px;
  }

  /* Контактный столбец */
  .clinic__contacts {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .clinic__phone {
    font-size: var(--text-heading);
    letter-spacing: var(--track-heading);
    line-height: 1.1;
    transition: color 0.25s var(--ease);
  }
  .clinic__phone:hover {
    color: var(--lime);
  }
  .clinic__note {
    margin-top: 10px;
  }
  .clinic__places {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: clamp(24px, 3vw, 36px);
  }
  .clinic__place {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .clinic__place-name {
    font-size: var(--text-card-title);
    letter-spacing: var(--track-heading);
  }
  .clinic__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(24px, 3vw, 36px);
  }
  /* Компактный чип по содержимому */
  .clinic__link {
    display: inline-flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 18px;
    border: 1px solid var(--sea);
    border-radius: var(--radius-card);
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .clinic__link:hover {
    border-color: var(--lime);
    background: rgba(206, 247, 158, 0.06);
  }
  .clinic__legal {
    margin-top: clamp(24px, 3vw, 36px);
  }

  /* ================= ГАЛЕРЕЯ =================
     Ни тега, ни заголовка: секция — это ровно набор кадров. Контейнера тоже
     нет, мозаика берёт всю ширину экрана. */
  .gallery__grid {
    /* Ручка плотности сетки. Высота ряда считается от ширины колонки:
       горизонтальный кадр 3:2 занимает ровно один ряд, вертикальный — два.
       Вертикаль при этом подрезается на ~11% (2 ряда дают 4/3 ширины
       колонки вместо натуральных 3/2) — за это отвечает object-fit: cover. */
    --cols: 3;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-auto-rows: calc(100vw / var(--cols) * 2 / 3);
    grid-auto-flow: dense;
  }
  /* На десктопе обёртки как будто нет: сетка остаётся прямым потомком секции */
  .gallery__stage {
    display: contents;
  }
  .gallery__fade {
    display: none;
  }
  /* Плитка — кнопка: сброс дефолтов браузера, никаких радиусов и зазоров */
  .gallery__tile {
    position: relative;
    overflow: hidden;
    border: 0;
    padding: 0;
    background: var(--tissue);
    cursor: zoom-in;
    font: inherit;
    color: inherit;
  }
  .gallery__tile--v {
    grid-row: span 2;
  }
  .gallery__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .gallery__tile:hover img,
  .gallery__tile:focus-visible img {
    transform: scale(1.02);
  }
  .gallery__tile:focus-visible {
    outline: 2px solid var(--lime-2);
    outline-offset: -4px;
  }

  /* ---------- Лайтбокс ---------- */
  .lbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(8px, 2vw, 28px);
    padding: clamp(56px, 8vh, 88px) clamp(12px, 3vw, 40px);
    /* Сплошной, а не полупрозрачный: даже на 3% просвета текст страницы
       из-под оверлея читался и мешал смотреть кадр. */
    background: var(--ink);
    color: var(--paper);
  }
  .lbox[hidden] {
    display: none;
  }
  .lbox__stage {
    display: grid;
    place-items: center;
    min-width: 0;
    height: 100%;
  }
  .lbox__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  /* Стрелки — тот же лаймовый чип, что и у BtnPair, только круглее задачей */
  .lbox__nav {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border: 0;
    border-radius: var(--radius-btn);
    background: var(--lime);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.25s var(--ease);
  }
  .lbox__nav:hover {
    background: var(--lime-2);
  }
  .lbox__close {
    position: absolute;
    top: clamp(12px, 2.4vh, 24px);
    right: clamp(12px, 3vw, 40px);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--sea);
    border-radius: var(--radius-btn);
    background: transparent;
    color: var(--paper);
    cursor: pointer;
    transition: border-color 0.25s var(--ease);
  }
  .lbox__close:hover {
    border-color: var(--lime-2);
  }
  .lbox__nav:focus-visible,
  .lbox__close:focus-visible {
    outline: 2px solid var(--lime-2);
    outline-offset: 3px;
  }
  .lbox__count {
    position: absolute;
    left: 50%;
    bottom: clamp(16px, 3vh, 28px);
    transform: translateX(-50%);
    color: var(--paper);
  }
  /* Пока страница под лайтбоксом — не скроллим её за спиной у оверлея.
     padding-right компенсирует исчезнувший скроллбар, иначе вёрстка дёргается. */
  :global(body.is-lbox-open) {
    overflow: hidden;
    padding-right: var(--sbw, 0px);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__tile img,
    .lbox__nav,
    .lbox__close {
      transition: none;
    }
    .gallery__tile:hover img,
    .gallery__tile:focus-visible img {
      transform: none;
    }
  }

  /* ================= АДАПТИВ ================= */
  @media (max-width: 900px) {
    /* Хиро без скролл-сцены: имя → фото → текст обычным потоком */
    .hero__track {
      height: auto;
    }
    .hero__sticky {
      position: static;
      height: auto;
    }
    .hero__frame {
      height: auto;
      display: flex;
      flex-direction: column;
      padding-top: 104px;
    }
    .hero__name {
      position: static;
      padding-inline: var(--gutter);
    }
    .hero__word {
      position: static;
      display: block;
      font-size: clamp(3.2rem, 16vw, 5.5rem);
      transform: none !important;
    }
    .hero__word--r {
      text-align: right;
    }
    .hero__photo {
      position: static;
      translate: none;
      width: min(88%, 420px);
      height: auto;
      max-height: 58svh;
      margin: -8px auto 0;
      scale: 1 !important;
      /* низ фото плавно растворяется — без резкой границы */
      -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 98%);
      mask-image: linear-gradient(to bottom, #000 72%, transparent 98%);
    }
    .hero__bottom {
      position: relative;
      z-index: 2;
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      /* текст приподнят и заходит на растворённый низ фото */
      margin-top: calc(-1 * clamp(56px, 12svh, 110px));
      padding: 0 var(--gutter) 8px;
      opacity: 1 !important;
      transform: none !important;
    }
    .halves__cols,
    .steps,
    .methods__grid,
    .inject__grid,
    .smas__inner,
    .inside__inner,
    .zones__list,
    .social__inner,
    .about__row,
    .care__cols,
    .clinic__inner {
      grid-template-columns: 1fr;
    }
    :global(.press__all) {
      margin-top: 24px;
    }
    /* Карточки со статистикой в две колонки не влезают — столбиком */
    .reviews__grid {
      grid-template-columns: 1fr;
    }
    .reviews__card {
      min-height: 0;
    }
    /* В одну колонку тянуть фото не по чему — возвращаем ему пропорцию */
    .care__media {
      min-height: 0;
      margin-top: clamp(28px, 5vw, 40px);
    }
    .care__media img {
      height: auto;
      aspect-ratio: 3 / 2;
    }
    .methods__card {
      min-height: 0;
    }
    .smas__media video,
    .inside__media video {
      aspect-ratio: 16 / 9;
    }
    /* На мобильном текст выше видео */
    .inside__media {
      order: 2;
    }
    .steps__panel {
      min-height: 0;
    }
    /* Заголовок принципа над текстом, а не колонкой слева */
    .principles__item {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    /* Ролики — лентой со свайпом: вчетвером в ряд они превратились бы
       в марки. Карточка занимает ~70% ширины, чтобы следующая выглядывала */
    .reels__row {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    .reels__row::-webkit-scrollbar {
      display: none;
    }
    .reels__card {
      flex: 0 0 min(70%, 300px);
      scroll-snap-align: start;
    }
    .cv__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    /* 28 кадров в две колонки — это семь экранов вертикальной колбасы: мозаика
       на телефоне не работает. Поэтому галерея превращается в ленту: высота
       в один экран, листается пальцем вбок. Приём на странице уже знакомый —
       так же ведёт себя слайдер методов. */
    .gallery__grid {
      display: flex;
      overflow-x: auto;
      height: min(52svh, 400px);
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .gallery__grid::-webkit-scrollbar {
      display: none;
    }
    /* Ширину задаёт пропорция самого кадра, а не общее число: в ленте
       фиксированной высоты подгонка всех плиток под одну ширину превращает
       горизонтальный кадр в вертикальный обрезок. Пусть лучше горизонталь
       будет шире экрана — свайп её и покажет. */
    .gallery__tile {
      flex: 0 0 auto;
      height: 100%;
      width: auto;
      scroll-snap-align: center;
    }
    .gallery__tile--v {
      aspect-ratio: 2 / 3;
    }
    .gallery__tile--h {
      aspect-ratio: 3 / 2;
    }
    .gallery__stage {
      display: block;
      position: relative;
    }
    /* Затухание у правого края — подсказка, что лента продолжается.
       Тот же приём, что у слайдера методов: гаснет к концу прокрутки,
       чтобы не мозолить глаза, когда листать уже некуда. */
    .gallery__fade {
      display: block;
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: clamp(48px, 14vw, 96px);
      background: linear-gradient(to left, var(--bone) 12%, transparent);
      pointer-events: none;
      transition: opacity 0.3s var(--ease);
    }
    .gallery__stage.is-end .gallery__fade {
      opacity: 0;
    }
    /* Стрелки по бокам съедали бы половину узкого экрана — уводим их вниз,
       кадр забирает всю ширину. Основной способ листать здесь всё равно свайп. */
    .lbox {
      grid-template-columns: minmax(0, 1fr);
      padding: 64px 12px 88px;
    }
    .lbox__nav {
      position: absolute;
      bottom: 22px;
    }
    .lbox__nav--prev {
      left: 12px;
    }
    .lbox__nav--next {
      right: 12px;
    }
  }

  /* На телефоне сцены нет (её отключает общий медиазапрос .mscroll), плашки
     листаются пальцем. Карточка почти во всю ширину: узкая колонка рассыпает
     заголовок публикации по два слова в строку. */
  @media (max-width: 640px) {
    .press__scene :global(.mscroll__card) {
      width: min(78vw, 320px);
      height: min(64svh, 480px);
    }
    .zones__list {
      gap: clamp(20px, 5vw, 32px);
    }
  }
</style>

<script>
  // Скролл-сцена хиро: фото по центру статично, имя выезжает с боков,
  // затем проявляется нижний блок с текстом и кнопкой.
  const track = document.querySelector('[data-hero-track]') as HTMLElement | null;
  const wordL = document.querySelector('[data-hero-l]') as HTMLElement | null;
  const wordR = document.querySelector('[data-hero-r]') as HTMLElement | null;
  const bottom = document.querySelector('[data-hero-bottom]') as HTMLElement | null;
  const photo = document.querySelector('[data-hero-photo]') as HTMLElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobile = window.matchMedia('(max-width: 900px)').matches;

  if (track && wordL && wordR && bottom && !reduced && !mobile) {
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    const seg = (p: number, from: number, to: number) =>
      Math.min(1, Math.max(0, (p - from) / (to - from)));

    let ticking = false;
    const render = () => {
      ticking = false;
      const rect = track.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const p = Math.min(1, Math.max(0, -rect.top / total));

      // фаза 1 (0–0.55): имя въезжает с боков
      const tName = easeOut(seg(p, 0.05, 0.55));
      wordL.style.transform = `translateX(${(-110 * (1 - tName)).toFixed(2)}vw)`;
      wordR.style.transform = `translateX(${(110 * (1 - tName)).toFixed(2)}vw)`;

      // фаза 2 (0.55–0.9): нижний блок проявляется и поднимается
      const tBottom = easeOut(seg(p, 0.55, 0.9));
      bottom.style.opacity = tBottom.toFixed(3);
      bottom.style.transform = `translateY(${(40 * (1 - tBottom)).toFixed(1)}px)`;

      // фото едва заметно «оседает» из лёгкого приближения (только десктоп —
      // ниже 900px сцена не запускается, а фото прибито `scale: 1 !important`)
      if (photo) photo.style.scale = String(1.05 - 0.05 * easeOut(seg(p, 0, 0.4)));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };
    document.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    render();
  } else if (wordL && wordR && bottom) {
    wordL.style.transform = 'none';
    wordR.style.transform = 'none';
    bottom.style.opacity = '1';
    bottom.style.transform = 'none';
  }

  // Горизонтальный скролл-слайдер «Аппаратные методы»:
  // вертикальная прокрутка страницы двигает ряд плашек по горизонтали.
  // Сцен на странице две — аппаратные методы и пресса, механика одна
  const scenes = document.querySelectorAll('[data-mscroll]');
  scenes.forEach((ms) => {
    if (reduced || !window.matchMedia('(min-width: 901px)').matches) return;
    const msTrack = ms.querySelector('[data-mscroll-track]') as HTMLElement;
    const msVp = ms.querySelector('[data-mscroll-viewport]') as HTMLElement;
    const msRow = ms.querySelector('[data-mscroll-row]') as HTMLElement;
    const msFade = ms.querySelector('[data-mscroll-fade]') as HTMLElement | null;
    let maxShift = 0;

    const msUpdate = () => {
      const rect = msTrack.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
      msRow.style.transform = `translate3d(${(-maxShift * p).toFixed(1)}px, 0, 0)`;
      // затухание справа исчезает, когда доехали до последней плашки
      if (msFade) msFade.style.opacity = String(Math.min(1, (1 - p) * 6));
    };
    const msMeasure = () => {
      const vpStyles = getComputedStyle(msVp);
      const pads = parseFloat(vpStyles.paddingLeft) + parseFloat(vpStyles.paddingRight);
      maxShift = Math.max(0, msRow.scrollWidth - (msVp.clientWidth - pads));
      // Высота трека = экран + путь: по умолчанию плашки едут пиксель в пиксель
      // со скроллом. У прессы плашек 12 против четырёх у методов, и при 1:1
      // блок съедал бы почти три экрана прокрутки — ей задан множитель,
      // и лента листается быстрее скролла.
      const speed = parseFloat((ms as HTMLElement).dataset.mscrollSpeed ?? '1');
      msTrack.style.height = `calc(100svh + ${Math.round(maxShift * speed)}px)`;
      msUpdate();
    };

    let msTicking = false;
    const msOnScroll = () => {
      if (!msTicking) {
        msTicking = true;
        requestAnimationFrame(() => {
          msTicking = false;
          msUpdate();
        });
      }
    };
    document.addEventListener('scroll', msOnScroll, { passive: true });
    window.addEventListener('resize', msMeasure, { passive: true });
    msMeasure();
  });

  // «Молекулы»: дрейфующие узлы со связями — научный слой за фото.
  const canvas = document.querySelector('[data-hero-mol]') as HTMLCanvasElement | null;
  if (canvas && !reduced) {
    const ctx = canvas.getContext('2d')!;
    const DOTS = 46;
    const LINK = 150; // максимальная длина связи, px
    let w = 0, h = 0, dpr = 1;
    type Dot = { x: number; y: number; vx: number; vy: number; r: number; lime: boolean };
    let dots: Dot[] = [];

    const seed = () => {
      dots = Array.from({ length: DOTS }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
        r: 1.5 + Math.random() * 2.5,
        lime: Math.random() < 0.22, // каждая ~пятая точка — лаймовый «сигнал»
      }));
    };
    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(2, window.devicePixelRatio || 1);
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (!dots.length) seed();
    };

    const tick = () => {
      ctx.clearRect(0, 0, w, h);
      for (const d of dots) {
        d.x += d.vx;
        d.y += d.vy;
        if (d.x < -20) d.x = w + 20; else if (d.x > w + 20) d.x = -20;
        if (d.y < -20) d.y = h + 20; else if (d.y > h + 20) d.y = -20;
      }
      // связи
      for (let i = 0; i < dots.length; i++) {
        for (let j = i + 1; j < dots.length; j++) {
          const a = dots[i], b = dots[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const dist = Math.hypot(dx, dy);
          if (dist < LINK) {
            const alpha = (1 - dist / LINK) * 0.35;
            ctx.strokeStyle = `rgba(140, 150, 135, ${alpha.toFixed(3)})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
      // узлы
      for (const d of dots) {
        ctx.beginPath();
        ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
        ctx.fillStyle = d.lime ? 'rgba(167, 226, 110, 0.9)' : 'rgba(140, 150, 135, 0.55)';
        ctx.fill();
        if (d.lime) {
          // ореол вокруг лаймовых узлов
          ctx.beginPath();
          ctx.arc(d.x, d.y, d.r + 5, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(167, 226, 110, 0.25)';
          ctx.stroke();
        }
      }
      raf = requestAnimationFrame(tick);
    };

    let raf = 0;
    resize();
    window.addEventListener('resize', resize, { passive: true });
    // не жечь батарею, когда вкладка скрыта или хиро уехал из вьюпорта
    const vis = new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      if (e.isIntersecting) raf = requestAnimationFrame(tick);
    });
    vis.observe(canvas);
  }

  // 5. Аппаратные методы — скролл и переключение плашек
  const methodsScroll = document.querySelector<HTMLElement>('[data-methods-scroll]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-methods-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-methods-next]');
  const dots = document.querySelectorAll<HTMLButtonElement>('[data-methods-dot]');

  if (methodsScroll) {
    const stage = methodsScroll.closest<HTMLElement>('.methods__stage');

    const updateNav = () => {
      const scrollLeft = methodsScroll.scrollLeft;
      const maxScroll = methodsScroll.scrollWidth - methodsScroll.clientWidth;

      stage?.classList.toggle('has-scroll-left', scrollLeft > 10);
      stage?.classList.toggle('has-scroll-right', scrollLeft < maxScroll - 10);

      if (prevBtn) prevBtn.disabled = scrollLeft <= 8;
      if (nextBtn) nextBtn.disabled = scrollLeft >= maxScroll - 8;

      const card = methodsScroll.querySelector<HTMLElement>('.methods__card');
      const step = card ? card.offsetWidth + 20 : 320;
      const activeIdx = Math.min(dots.length - 1, Math.max(0, Math.round(scrollLeft / step)));

      dots.forEach((dot, idx) => {
        dot.classList.toggle('is-active', idx === activeIdx);
      });
    };

    methodsScroll.addEventListener('scroll', updateNav, { passive: true });
    updateNav();

    // Скролл колесиком мыши по горизонтали при вызове колесика над областью плашек
    methodsScroll.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) < Math.abs(e.deltaY)) {
        const canScrollLeft = methodsScroll.scrollLeft > 0 && e.deltaY < 0;
        const canScrollRight = methodsScroll.scrollLeft < (methodsScroll.scrollWidth - methodsScroll.clientWidth - 5) && e.deltaY > 0;
        if (canScrollLeft || canScrollRight) {
          e.preventDefault();
          methodsScroll.scrollBy({ left: e.deltaY * 1.1, behavior: 'smooth' });
        }
      }
    }, { passive: false });

    prevBtn?.addEventListener('click', () => {
      const card = methodsScroll.querySelector<HTMLElement>('.methods__card');
      const step = card ? card.offsetWidth + 20 : 320;
      methodsScroll.scrollBy({ left: -step, behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      const card = methodsScroll.querySelector<HTMLElement>('.methods__card');
      const step = card ? card.offsetWidth + 20 : 320;
      methodsScroll.scrollBy({ left: step, behavior: 'smooth' });
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        const card = methodsScroll.querySelector<HTMLElement>('.methods__card');
        const step = card ? card.offsetWidth + 20 : 320;
        methodsScroll.scrollTo({ left: idx * step, behavior: 'smooth' });
      });
    });
  }

  // Горизонтальные ленты: таймлайн «Обо мне» и карточки прессы. Механика одна —
  // колесо двигает вбок, мышь тянет, в конце гаснут подсказка и градиент
  // (класс is-end на корне блока), поэтому живёт одной функцией на обе.
  const hookRail = (rail: HTMLElement | null, root: HTMLElement | null) => {
    if (!rail) return;

    const atEnd = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      // max <= 1 — лента целиком влезла в экран, тянуть нечего
      return max <= 1 || rail.scrollLeft >= max - 8;
    };
    const updateEnd = () => root?.classList.toggle('is-end', atEnd());

    rail.addEventListener('scroll', updateEnd, { passive: true });
    window.addEventListener('resize', updateEnd);
    updateEnd();

    // Вертикальное колесо мыши двигает ленту вбок, но только пока внутри есть
    // куда ехать: на краях отдаём событие странице, иначе скролл «залипает».
    rail.addEventListener(
      'wheel',
      (e) => {
        if (Math.abs(e.deltaX) >= Math.abs(e.deltaY)) return;
        const max = rail.scrollWidth - rail.clientWidth;
        const canLeft = rail.scrollLeft > 0 && e.deltaY < 0;
        const canRight = rail.scrollLeft < max - 5 && e.deltaY > 0;
        if (canLeft || canRight) {
          e.preventDefault();
          rail.scrollLeft += e.deltaY;
        }
      },
      { passive: false }
    );

    // Тянуть мышью. Порог в 4px — чтобы обычный клик не считался перетаскиванием.
    let down = false;
    let startX = 0;
    let startScroll = 0;
    let moved = false;

    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return; // палец и так скроллит нативно
      down = true;
      moved = false;
      startX = e.clientX;
      startScroll = rail.scrollLeft;
    });

    rail.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) < 4) return;
      if (!moved) {
        moved = true;
        rail.classList.add('is-dragging');
        rail.setPointerCapture(e.pointerId);
      }
      e.preventDefault();
      rail.scrollLeft = startScroll - dx;
    });

    const endDrag = (e: PointerEvent) => {
      if (!down) return;
      down = false;
      rail.classList.remove('is-dragging');
      if (rail.hasPointerCapture(e.pointerId)) rail.releasePointerCapture(e.pointerId);
    };
    rail.addEventListener('pointerup', endDrag);
    rail.addEventListener('pointercancel', endDrag);

    // Карточка ленты — ссылка: после перетаскивания гасим клик, иначе любая
    // протяжка мышью уводит на сайт издания.
    rail.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true
    );
  };

  // Фоновые видео секций: грузим, только когда секция подъезжает к экрану.
  // rootMargin даёт запас в пол-экрана, чтобы ролик успел стартовать
  // до того, как его увидят, и место постера не мигнуло пустотой.
  const lazyVideos = document.querySelectorAll<HTMLVideoElement>('[data-lazy-video]');
  if (lazyVideos.length) {
    const load = (v: HTMLVideoElement) => {
      const src = v.dataset.lazyVideo;
      if (!src || v.src) return;
      v.src = src;
      // play() отдаёт промис и отклоняется, если вкладка неактивна —
      // это не ошибка, просто гасим, чтобы не сорить в консоль.
      v.play().catch(() => {});
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            load(e.target as HTMLVideoElement);
            io.unobserve(e.target);
          }
        },
        { rootMargin: '50% 0px' }
      );
      lazyVideos.forEach((v) => io.observe(v));
    } else {
      lazyVideos.forEach(load);
    }
  }

  // ================= 11. ВИДЕО =================
  // Ролик грузится только по клику: до этого в карточке лежит постер.
  // Играющий всегда один — запуск соседа останавливает предыдущий.
  const reelCards = document.querySelectorAll<HTMLElement>('.reels__card');
  reelCards.forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>('.reels__video');
    const ui = card.querySelector<HTMLElement>('.reels__ui');
    const toggle = card.querySelector<HTMLButtonElement>('.reels__toggle');
    const bar = card.querySelector<HTMLElement>('.reels__bar');
    const fill = card.querySelector<HTMLElement>('.reels__fill');
    const sound = card.querySelector<HTMLButtonElement>('.reels__sound');
    const full = card.querySelector<HTMLButtonElement>('.reels__full');
    if (!video || !ui || !toggle || !bar || !fill || !sound || !full) return;

    const icon = (btn: HTMLElement, show: string, hide: string) => {
      btn.querySelector<HTMLElement>(show)?.removeAttribute('hidden');
      btn.querySelector<HTMLElement>(hide)?.setAttribute('hidden', '');
    };

    const start = () => {
      if (video.src) return;
      const src = video.dataset.reel;
      if (!src) return;
      video.src = src;
      ui.hidden = false;
      card.classList.add('is-playing');
    };

    const play = () => {
      // Играет всегда один ролик: соседей ставим на паузу
      reelCards.forEach((other) => {
        if (other === card) return;
        other.querySelector<HTMLVideoElement>('.reels__video')?.pause();
      });
      video.play().catch(() => {});
    };

    // Клик по самой карточке (не по пульту) — пуск и пауза
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.reels__ui')) return;
      start();
      if (video.paused) play();
      else video.pause();
    });

    toggle.addEventListener('click', () => {
      if (video.paused) play();
      else video.pause();
    });

    video.addEventListener('play', () => {
      card.classList.remove('is-paused');
      icon(toggle, '.reels__i-pause', '.reels__i-play');
      toggle.setAttribute('aria-label', 'Пауза');
    });
    video.addEventListener('pause', () => {
      card.classList.add('is-paused');
      icon(toggle, '.reels__i-play', '.reels__i-pause');
      toggle.setAttribute('aria-label', 'Продолжить');
    });

    video.addEventListener('timeupdate', () => {
      const p = video.duration ? (video.currentTime / video.duration) * 100 : 0;
      fill.style.width = `${p}%`;
      bar.setAttribute('aria-valuenow', String(Math.round(p)));
    });

    // Перемотка: клик и протяжка по полосе
    const seek = (clientX: number) => {
      const r = bar.getBoundingClientRect();
      const ratio = Math.min(Math.max((clientX - r.left) / r.width, 0), 1);
      if (video.duration) video.currentTime = ratio * video.duration;
    };
    bar.addEventListener('pointerdown', (e) => {
      start();
      bar.setPointerCapture(e.pointerId);
      seek(e.clientX);
    });
    bar.addEventListener('pointermove', (e) => {
      if (bar.hasPointerCapture(e.pointerId)) seek(e.clientX);
    });
    bar.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      video.currentTime += e.key === 'ArrowRight' ? 5 : -5;
    });

    sound.addEventListener('click', () => {
      video.muted = !video.muted;
      icon(sound, video.muted ? '.reels__i-off' : '.reels__i-on', video.muted ? '.reels__i-on' : '.reels__i-off');
      sound.setAttribute('aria-label', video.muted ? 'Включить звук' : 'Выключить звук');
    });

    full.addEventListener('click', () => {
      // iOS не умеет фуллскрин на произвольном элементе — только на самом
      // <video>, и через свой префиксный метод
      const ios = (video as any).webkitEnterFullscreen;
      if (document.fullscreenElement) document.exitFullscreen();
      else if (card.requestFullscreen) card.requestFullscreen().catch(() => {});
      else if (ios) ios.call(video);
    });
  });

  // 6. Обо мне — таймлайн образования и практики
  hookRail(
    document.querySelector<HTMLElement>('[data-cv-scroll]'),
    document.querySelector<HTMLElement>('[data-cv]')
  );
  // Пресса на главной ленту больше не использует — там сцена [data-mscroll]

  // ================= ЛЕНТА ГАЛЕРЕИ (телефон) =================
  // На узких экранах мозаика превращается в горизонтальную ленту. Градиент
  // справа держим, пока есть куда листать, и гасим на последнем кадре.
  const strip = document.querySelector('[data-gallery-strip]') as HTMLElement | null;
  const stripStage = document.querySelector('[data-gallery-stage]') as HTMLElement | null;

  if (strip && stripStage) {
    const syncFade = () => {
      const atEnd = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4;
      // На десктопе ленты нет: сетка не прокручивается, и условие всегда истинно
      stripStage.classList.toggle('is-end', atEnd);
    };
    strip.addEventListener('scroll', syncFade, { passive: true });
    window.addEventListener('resize', syncFade);
    syncFade();
  }

  // ================= ЛАЙТБОКС ГАЛЕРЕИ =================
  // Плитка несёт в data-атрибутах всё, что нужно оверлею: крупный файл и alt.
  // Отдельного массива в JS не держим — иначе он разъедется с разметкой.
  const lbox = document.querySelector('[data-lbox]') as HTMLElement | null;
  const lboxImg = document.querySelector('[data-lbox-img]') as HTMLImageElement | null;
  const lboxCount = document.querySelector('[data-lbox-count]') as HTMLElement | null;
  const tiles = Array.from(
    document.querySelectorAll('[data-lbox-open]')
  ) as HTMLButtonElement[];

  if (lbox && lboxImg && lboxCount && tiles.length) {
    const prevBtn = lbox.querySelector('[data-lbox-prev]') as HTMLButtonElement;
    const nextBtn = lbox.querySelector('[data-lbox-next]') as HTMLButtonElement;
    const closeBtn = lbox.querySelector('[data-lbox-close]') as HTMLButtonElement;
    const focusable = [prevBtn, nextBtn, closeBtn];

    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + tiles.length) % tiles.length;
      const tile = tiles[current];
      const thumb = tile.querySelector('img') as HTMLImageElement;
      // Пока грузится крупный кадр, показываем уже скачанную плитку —
      // вместо пустоты зритель видит ту же картинку, только мягче.
      lboxImg.src = thumb.currentSrc || thumb.src;
      lboxImg.alt = thumb.alt;
      const full = new Image();
      const wanted = tile.dataset.full as string;
      full.onload = () => {
        if (tile.dataset.full === wanted) lboxImg.src = wanted;
      };
      full.src = wanted;
      lboxCount.textContent = `${String(current + 1).padStart(2, '0')} / ${tiles.length}`;
    };

    const open = (i: number) => {
      opener = tiles[i];
      // Ширина скроллбара — чтобы страница не дёрнулась вбок под оверлеем
      const sbw = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.setProperty('--sbw', `${sbw}px`);
      document.body.classList.add('is-lbox-open');
      lbox.hidden = false;
      show(i);
      closeBtn.focus();
    };

    const close = () => {
      lbox.hidden = true;
      document.body.classList.remove('is-lbox-open');
      document.body.style.removeProperty('--sbw');
      opener?.focus();
      opener = null;
    };

    tiles.forEach((tile, i) => tile.addEventListener('click', () => open(i)));
    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    closeBtn.addEventListener('click', close);
    // Клик мимо кадра закрывает; по самому кадру и кнопкам — нет
    lbox.addEventListener('click', (e) => {
      if (e.target === lbox || (e.target as HTMLElement).classList.contains('lbox__stage')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (lbox.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
      else if (e.key === 'Tab') {
        // Фокус-ловушка: по кругу между тремя кнопками оверлея
        e.preventDefault();
        const at = focusable.indexOf(document.activeElement as HTMLButtonElement);
        const step = e.shiftKey ? -1 : 1;
        focusable[(at + step + focusable.length) % focusable.length].focus();
      }
    });

    // Свайп на тач-экранах. Порог 45px, вертикальный жест игнорируем,
    // чтобы обычная прокрутка пальцем не листала галерею.
    let sx = 0;
    let sy = 0;
    lbox.addEventListener(
      'touchstart',
      (e) => {
        sx = e.changedTouches[0].clientX;
        sy = e.changedTouches[0].clientY;
      },
      { passive: true }
    );
    lbox.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - sx;
        const dy = e.changedTouches[0].clientY - sy;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
      },
      { passive: true }
    );
  }
</script>
