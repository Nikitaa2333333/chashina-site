---
// Раздел «Видео» — весь архив роликов. На главной остаётся витрина
// с кнопкой сюда: приём тот же, что у прессы и блога.
// Просьба Оксаны: «может тогда всё-таки их в блок с переходом со стартовой
// сделать? То есть проваливаться туда, как со статьями» — у неё
// профессиональных роликов много, на главной им места нет.
//
// Два жанра идут РАЗНЫМИ блоками, а не вперемешку: горизонтальный разбор
// процедуры на 2,5 минуты и вертикальный ответ на вопрос из приёма —
// разное время просмотра и разный повод. В одном ряду читались бы
// случайным набором.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoCard from '../components/VideoCard.astro';
import { demos, reels } from '../data/videos';
---

<Base
  title="Видео — Оксана Чащина, врач-косметолог"
  description="Разборы процедур из клиники и короткие ответы на вопросы, которые чаще всего задают на приёме. Оксана Чащина, врач-косметолог, Москва."
>
  <Header />

  <main class="section video-page">
    <div class="container">
      <a class="crumb mono" href="/">← На главную</a>
      <span class="tag mono">Видео</span>
      <h1 class="video-page__title">Как это выглядит и как я объясняю.</h1>
    </div>

    <div class="container video-page__block">
      <h2 class="video-page__head">Процедуры</h2>
      <div class="video-page__demos">
        {demos.map((d) => (
          <figure class="vcard">
            <VideoCard src={d.src} poster={d.poster} ratio="landscape" w={1000} h={562} label={`Смотреть: ${d.title}`} />
            <figcaption class="vcard__cap">
              <span class="vcard__name">{d.title}</span>
              <span class="vcard__time mono">{d.time}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="container video-page__block">
      <h2 class="video-page__head">Ответы на вопросы с приёма</h2>
      <div class="video-page__reels">
        {reels.map((r) => (
          <VideoCard src={r.src} poster={r.poster} ratio="portrait" w={540} h={960} />
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .video-page {
    padding-top: 108px; /* шапка fixed */
  }
  .video-page__title {
    font-size: var(--text-display);
    letter-spacing: var(--track-display);
    line-height: 1.1;
    max-width: var(--measure-head);
    margin-top: 12px;
  }
  .video-page__block {
    margin-top: clamp(40px, 5vw, 72px);
  }
  .video-page__head {
    font-size: var(--text-card-title);
    letter-spacing: var(--track-heading);
    margin-bottom: var(--block-gap);
  }

  /* Разборы процедур: два в ряд, 16:9. Оформление карточки — .reels__card
     в global.css, общее с главной; тут только сетка и подписи. */
  .video-page__demos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 1.8vw, 28px);
  }
  .vcard__cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--sage);
  }
  .vcard__name {
    font-size: var(--text-card-title);
    letter-spacing: var(--track-heading);
    line-height: 1.2;
  }
  .vcard__time {
    font-size: var(--text-caption);
    flex: none;
  }

  /* Вертикалки: сеткой, а не лентой — тут их смотрят списком, листать
     вбок незачем. Колонки резиновые, чтобы ряд не ломался, когда роликов
     станет больше четырёх. */
  .video-page__reels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: clamp(12px, 1.4vw, 20px);
  }

  @media (max-width: 760px) {
    /* Два кадра 16:9 в ряд на телефоне — это две марки по 170px.
       В одну колонку ролик видно, а смотреть его тут и приходят. */
    .video-page__demos {
      grid-template-columns: 1fr;
    }
    .video-page__reels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
