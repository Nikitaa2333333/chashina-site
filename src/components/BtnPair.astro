---
// Фирменный узел референса: тёмная пилюля с текстом + лаймовый чип со стрелкой.
// Стык — не прямые прямоугольники, а SVG-формы со скошенным изогнутым краем
// (пути сняты с integratedbio.com один в один).
interface Props {
  href?: string;
  label: string;
  class?: string;
}
const { href = '#', label, class: cls = '' } = Astro.props;
---

<a class={`btn-pair ${cls}`} href={href}>
  <span class="btn-pair__label">
    <span class="mono">{label}</span>
    <svg class="btn-pair__corner" xmlns="http://www.w3.org/2000/svg" width="18" height="48" fill="none" viewBox="0 0 18 48" aria-hidden="true">
      <path fill="currentColor" d="M0 0h5.63c7.808 0 13.536 7.337 11.642 14.91l-6.09 24.359A11.527 11.527 0 0 1 0 48V0Z"/>
    </svg>
  </span>
  <span class="btn-pair__icon" aria-hidden="true">
    <svg class="btn-pair__chip" xmlns="http://www.w3.org/2000/svg" width="51" height="48" fill="none" viewBox="0 0 51 48">
      <path fill="currentColor" d="M6.728 9.09A12 12 0 0 1 18.369 0H39c6.627 0 12 5.373 12 12v24c0 6.627-5.373 12-12 12H12.37C4.561 48-1.167 40.663.727 33.09l6-24Z"/>
    </svg>
    <svg class="btn-pair__arrow" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 10 10" fill="none">
      <path d="M3.2 1.6 6.8 5 3.2 8.4" stroke="#222F30" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</a>

<style>
  .btn-pair {
    display: inline-flex;
    align-items: stretch;
    gap: 6px;
    height: 48px;
  }
  .btn-pair__label {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 12px 0 22px;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-nav) 0 0 var(--radius-nav);
    transition: background 0.45s var(--ease), color 0.45s var(--ease);
  }
  /* Скошенный правый край пилюли — SVG тем же цветом, что и пилюля.
     Заезжает на пилюлю на пиксель: встык (left: 100%) на дробной раскладке
     между фоном и SVG остаётся светлая щель, и кнопка выглядит разрезанной. */
  .btn-pair__corner {
    position: absolute;
    left: calc(100% - 1px);
    top: 0;
    color: var(--ink);
    transition: color 0.45s var(--ease);
  }
  .btn-pair__icon {
    position: relative;
    width: 51px;
    height: 48px;
    margin-left: 17px; /* место под corner-svg (18px минус его нахлёст) */
    color: var(--lime);
    transition: color 0.45s var(--ease);
  }
  .btn-pair__chip {
    display: block;
  }
  .btn-pair__arrow {
    position: absolute;
    top: 50%;
    left: 55%;
    translate: -50% -50%;
    transition: translate 0.45s var(--ease);
  }
  /* Ховер: обе формы заливаются лаймом, текст темнеет, галочка уезжает вправо.
     !important перебивает вариант «светлая кнопка на тёмной плашке» из секций */
  .btn-pair:hover .btn-pair__label {
    background: var(--lime) !important;
    color: var(--ink) !important;
  }
  .btn-pair:hover .btn-pair__corner {
    color: var(--lime) !important;
  }
  .btn-pair:hover .btn-pair__icon {
    color: var(--lime-2);
  }
  .btn-pair:hover .btn-pair__arrow {
    translate: -20% -50%;
  }
</style>
