---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Картинка для соцсетей: путь от корня сайта. По умолчанию общая обложка. */
  image?: string;
  /** 'article' для постов блога — остальное website. */
  type?: 'website' | 'article';
  /** Служебная страница, которой нечего делать в поиске. */
  noindex?: boolean;
}
const {
  title,
  description = 'Врач-косметолог, дерматолог. Инъекционные и аппаратные методики с доказанной эффективностью.',
  image = '/og-cover.jpg',
  type = 'website',
  noindex = false,
} = Astro.props;

// Канонический адрес страницы. Astro.site — это `site` из astro.config.mjs;
// без него new URL() падает, поэтому домен там обязателен.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Соцсети и мессенджеры: без og:* ссылка на сайт приезжает голой строкой -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Оксана Чащина" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- SVG для современных браузеров, .ico — для тех, кто по привычке
         тянет /favicon.ico, и для выдачи Яндекса с Google: они рисуют
         иконку рядом со ссылкой и SVG понимают не везде. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/InterTight-400-cyr.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/InterTight-400-lat.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/RobotoMono-400-cyr.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>

    <!-- Яндекс.Метрика, счётчик 112190429. Код из панели, как есть.
         is:inline обязателен: иначе Astro утащит скрипт в свой бандл,
         отложит выполнение, и часть просмотров потеряется. Клиентского
         роутера на сайте нет — переходы перезагружают страницу, и хит
         на смену маршрута докидывать не нужно. -->
    <script is:inline type="text/javascript">
      (function(m,e,t,r,i,k,a){
          m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=112190429', 'ym');

      ym(112190429, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>

    <!-- Сюда страницы кладут своё: разметку schema.org, коды подтверждения -->
    <slot name="head" />
  </head>
  <body>
    <noscript><div><img src="https://mc.yandex.ru/watch/112190429" style="position:absolute; left:-9999px;" alt="" /></div></noscript>

    <slot />

    <script>
      // Глобальный проход типографа: висячие предлоги → неразрывный пробел
      import { typo } from '../lib/typo';

      function fixTypography(root: HTMLElement | null = document.body) {
        if (!root) return;
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            const tag = node.parentElement?.tagName;
            if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'TEXTAREA' || tag === 'CODE' || tag === 'PRE')
              return NodeFilter.FILTER_REJECT;
            return node.nodeValue && node.nodeValue.trim()
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_REJECT;
          },
        });
        const nodes: Text[] = [];
        let n: Node | null;
        while ((n = walker.nextNode())) nodes.push(n as Text);
        for (const t of nodes) {
          const fixed = typo(t.nodeValue ?? '');
          if (fixed !== t.nodeValue) t.nodeValue = fixed;
        }
      }
      fixTypography();
      document.addEventListener('astro:page-load', () => fixTypography());
    </script>
  </body>
</html>
