# Весь трафик — на https. Без этого браузер, открывший сайт по http
# (набрали домен руками, перешли по старой ссылке), показывает
# «Не защищено», хотя сертификат на домене есть.
#
# Лежит в public/, поэтому Astro кладёт его в dist/ и rsync заливает
# на хостинг вместе со сборкой. В корне репозитория держать бесполезно —
# деплоится только содержимое dist/.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS=on — прямой запрос по https; X-Forwarded-Proto — когда https
  # терминирует фронтовый nginx хостинга и до Apache доезжает уже http.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Своя страница вместо стандартной ошибки Apache. Астро собирает её
# из src/pages/404.astro в dist/404.html.
ErrorDocument 404 /404.html

# Кеш статики. Хостинг по умолчанию отдаёт её без срока жизни, и браузер
# тянет шрифты с картинками заново на каждом визите.
<IfModule mod_headers.c>
  # Сборка Astro: имя файла содержит хеш содержимого, поэтому кешируем
  # навсегда — изменится файл, изменится и адрес.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Шрифты не меняются вовсе.
  <FilesMatch "\.(woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Картинки и видео живут под своими именами: год без immutable, чтобы
  # замена файла тем же именем доезжала до вернувшегося посетителя.
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML не кешируем: правки текста должны появляться сразу после деплоя.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
